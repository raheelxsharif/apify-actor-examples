    "maxDuration": {
      "description": "Only include videos at most this many seconds long.",
      "maximum": 86400,
      "minimum": 0,
      "title": "Maximum duration (seconds)",
      "type": "integer"
    },
    "maxItems": {
      "default": 20,
      "description": "Maximum number of records to return. Up to 1,000 comes from a single query; higher values automatically sweep Dailymotion's date windows (search/topic/channel modes, newest-first or oldest-first order). Playlist and channel-search modes stay capped at 1,000 per query.",
      "maximum": 10000,
      "minimum": 1,
      "prefill": 3,
      "title": "Max items",
      "type": "integer"
    },
    "minDuration": {
      "description": "Only include videos at least this many seconds long.",
      "maximum": 86400,
      "minimum": 0,
      "title": "Minimum duration (seconds)",
      "type": "integer"
    },
    "mode": {
      "default": "search",
      "description": "What to fetch from Dailymotion.",
      "editor": "select",
      "enum": [
        "search",
        "trending",
        "byTopic",
        "byUser",
        "byPlaylist",
        "byVideoIds",
        "searchUsers"
      ],
      "enumTitles": [
        "Search videos by keyword",
        "Trending videos",
        "Browse a topic/category",
        "Videos from a channel (username)",
        "Videos in a playlist",
        "Look up specific videos by ID or URL",
        "Search channels/users"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "playlists": {
      "default": [],
      "description": "One or more playlists to fetch (mode=byPlaylist). Accepts playlist URLs (`https://www.dailymotion.com/playlist/x6pu6c`) or bare playlist IDs. Existing tasks with the old `playlist` field keep working.",
      "editor": "stringList",
      "prefill": [],
      "title": "Playlist URLs or IDs",
      "type": "array"
    },
    "searchQueries": {
      "description": "One or more keywords to search (mode=search, mode=searchUsers). Each query is paginated up to Max items. Existing tasks with the old `searchQuery` field keep working.",
      "editor": "stringList",
      "prefill": [
        "technology news"
      ],
      "title": "Search queries",
      "type": "array"
    },
    "sortBy": {
      "default": "relevance",
      "description": "Result order. Values apply where the Dailymotion API supports them: `relevance` needs mode=search/searchUsers; `popular` is mode=searchUsers only; `old`/`id-asc` are not available in trending mode. Unsupported values fall back to the mode's default order and the run note says so. Runs with maxItems above 1,000 always use a recent/old time-ordered sweep.",
      "editor": "select",
      "enum": [
        "relevance",
        "recent",
        "trending",
        "visited",
        "visited-hour",
        "visited-today",
        "visited-week",
        "visited-month",
        "random",
        "old",
        "id-asc",
        "popular"
      ],
      "enumTitles": [
        "Most relevant",
        "Most recent",
        "Trending now",
        "Most viewed (all time)",
        "Most viewed this hour",
        "Most viewed today",
        "Most viewed this week",
        "Most viewed this month",
        "Random order",
        "Oldest first",
        "Oldest first (by ID)",
        "Most followed (searchUsers)"
      ],
      "prefill": "relevance",
      "title": "Sort order",
      "type": "string"
    },
    "tag": {
      "description": "Only include videos carrying this tag (mode=search, byTopic, byUser, byPlaylist). Example: `jazz`.",
      "editor": "textfield",
      "title": "Tag filter",
      "type": "string"
    },

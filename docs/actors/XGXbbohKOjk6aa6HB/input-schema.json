    "createdAfter": {
      "description": "Only include videos published on or after this date, as `YYYY-MM-DD` (mode=search, trending, byTopic, byUser). Long ranges are fetched automatically in overlapping windows. Dailymotion applies date filters in ~5-minute buckets, so a day boundary can include up to five minutes of neighbouring content.",
      "editor": "textfield",
      "title": "Published after",
      "type": "string"
    },
    "createdBefore": {
      "description": "Only include videos published on or before this date, as `YYYY-MM-DD` (mode=search, trending, byTopic, byUser). Long ranges are fetched automatically in overlapping windows. Dailymotion applies date filters in ~5-minute buckets, so a day boundary can include up to five minutes of neighbouring content.",
      "editor": "textfield",
      "title": "Published before",
      "type": "string"
    },

      "title": "Verified channels only",
      "type": "boolean"
    },
    "videoIds": {
      "default": [],
      "description": "Specific videos to look up (mode=byVideoIds). Accepts bare IDs (`x4d4447`), dailymotion.com/video/... links, or dai.ly links. Unavailable IDs are skipped.",
      "editor": "stringList",
      "prefill": [],
      "title": "Video IDs or URLs",
      "type": "array"
    }

{
  "description": "Search pros by service category and location, browse by category, or fetch individual pro profiles.",
  "properties": {
    "backgroundCheckedOnly": {
      "default": false,
      "description": "Only emit pros who have passed a background check.",
      "prefill": false,
      "title": "Background-checked only",
      "type": "boolean"
    },
    "category": {
      "default": "house-cleaning",
      "description": "Service category slug (mode=search or mode=byCategory).",
      "editor": "select",
      "enum": [
        "house-cleaning",
        "lawn-care",
        "plumber",
        "electrician",
        "handyman",
        "dog-walker",
        "personal-trainer",
        "photographer",
        "tutor",
        "moving",
        "painting",
        "hvac",
        "pest-control",
        "locksmith",
        "carpet-cleaning",
        "tree-service",
        "junk-removal",
        "computer-repair",
        "massage-therapist",
        "catering"
      ],
      "enumTitles": [
        "House Cleaning",
        "Lawn Care",
        "Plumber",
        "Electrician",
        "Handyman",
        "Dog Walker",
        "Personal Trainer",
        "Photographer",
        "Tutor",
        "Moving",
        "Painting",
        "HVAC",
        "Pest Control",
        "Locksmith",
        "Carpet Cleaning",
        "Tree Service",
        "Junk Removal",
        "Computer Repair",
        "Massage Therapist",
        "Catering"
      ],
      "prefill": "house-cleaning",
      "title": "Service category",
      "type": "string"
    },
    "city": {
      "default": "san-francisco",
      "description": "City name for location filtering (mode=search). E.g. `san-francisco`, `new-york`, `chicago`.",
      "editor": "textfield",
      "prefill": "san-francisco",
      "title": "City",
      "type": "string"
    },
    "maxItems": {
      "default": 5,
      "description": "Hard cap on emitted records.",
      "maximum": 1000,
      "minimum": 1,
      "prefill": 5,
      "title": "Max items",
      "type": "integer"
    },
    "minRating": {
      "description": "Only emit pros with rating >= this value.",
      "maximum": 5,
      "minimum": 0,
      "title": "Minimum rating",
      "type": "number"
    },
    "minReviews": {
      "description": "Only emit pros with at least this many reviews.",
      "maximum": 99999,
      "minimum": 0,
      "title": "Minimum review count",
      "type": "integer"
    },
    "mode": {
      "default": "search",
      "description": "What to scrape.",
      "editor": "select",
      "enum": [
        "search",
        "byProfile",
        "byCategory"
      ],
      "enumTitles": [
        "Search pros by category + location",
        "Single pro profile by URL",
        "Browse pros by category (no location filter)"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "profileUrls": {
      "default": [],
      "description": "List of Thumbtack pro profile URLs. E.g. `https://www.thumbtack.com/profile/jane-doe-cleaning/service/123456/`",
      "editor": "stringList",
      "prefill": [],
      "title": "Pro profile URLs (mode=byProfile)",
      "type": "array"
    },

{
  "description": "Search the CMS NPI Registry for US healthcare providers by name, state, specialty, or organization.",
  "properties": {
    "city": {
      "description": "Filter results to providers in this city.",
      "editor": "textfield",
      "title": "City",
      "type": "string"
    },
    "enumerationType": {
      "default": "",
      "description": "Filter by provider type. NPI-1 = individual providers, NPI-2 = organizations. Leave blank for all. Applies to mode=searchProviders.",
      "editor": "select",
      "enum": [
        "",
        "NPI-1",
        "NPI-2"
      ],
      "enumTitles": [
        "All (individuals and organizations)",
        "NPI-1 — Individual Providers",
        "NPI-2 — Organizations"
      ],
      "title": "Enumeration type (NPI type)",
      "type": "string"
    },
    "firstName": {
      "description": "Provider first name (modes: searchProviders, searchBySpecialty).",
      "editor": "textfield",
      "prefill": "John",
      "title": "First name",
      "type": "string"
    },
    "lastName": {
      "description": "Provider last name (modes: searchProviders, searchBySpecialty).",
      "editor": "textfield",
      "prefill": "Smith",
      "title": "Last name",
      "type": "string"
    },
    "maxItems": {
      "default": 50,
      "description": "Maximum number of provider records to return.",
      "maximum": 2000,
      "minimum": 1,
      "prefill": 50,
      "title": "Max items",
      "type": "integer"
    },
    "mode": {
      "default": "searchProviders",
      "description": "What to search in the NPI Registry.",
      "editor": "select",
      "enum": [
        "searchProviders",
        "lookupByNPI",
        "searchBySpecialty",
        "searchByOrganization"
      ],
      "enumTitles": [
        "Search providers by name / state",
        "Lookup specific provider by NPI number",
        "Search by specialty / taxonomy",
        "Search for organizations"
      ],
      "prefill": "searchProviders",
      "title": "Mode",
      "type": "string"
    },
    "npiNumber": {
      "description": "10-digit National Provider Identifier.",
      "editor": "textfield",
      "title": "NPI number (mode=lookupByNPI)",
      "type": "string"
    },
    "organizationName": {
      "description": "Organization or group name (mode=searchByOrganization).",
      "editor": "textfield",
      "title": "Organization name",
      "type": "string"
    },
    "postalCode": {
      "description": "Filter results by 5-digit US ZIP code.",
      "editor": "textfield",
      "title": "Postal code (ZIP)",
      "type": "string"
    },
    "specialtyDescription": {
      "description": "Free-text taxonomy or specialty description to filter by, e.g. 'Internal Medicine', 'Family Practice', 'Cardiology'.",
      "editor": "textfield",
      "title": "Specialty description",
      "type": "string"
    },
    "state": {
      "description": "US state abbreviation to filter providers.",
      "editor": "select",
      "enum": [
        "",
        "AK",
        "AL",
        "AR",
        "AZ",

{
  "description": "Scrape recipes from bbcgoodfood.com.",
  "properties": {
    "category": {
      "default": "",
      "description": "Recipe category to browse",
      "editor": "select",
      "enum": [
        "",
        "chicken-recipes",
        "pasta-recipes",
        "vegetarian-recipes",
        "vegan-recipes",
        "quick-healthy",
        "baking",
        "desserts"
      ],
      "enumTitles": [
        "Any",
        "Chicken",
        "Pasta",
        "Vegetarian",
        "Vegan",
        "Quick",
        "Baking",
        "Desserts"
      ],
      "prefill": "",
      "title": "Category",
      "type": "string"
    },
    "cuisine": {
      "description": "Cuisine type filter",
      "editor": "textfield",
      "title": "Cuisine Filter",
      "type": "string"
    },
    "maxItems": {
      "default": 20,
      "description": "Maximum number of recipes to return",
      "maximum": 500,
      "minimum": 1,
      "prefill": 20,
      "title": "Max Items",
      "type": "integer"
    },
    "minRating": {
      "description": "Minimum rating filter",
      "maximum": 5,
      "minimum": 1,
      "title": "Min Rating",
      "type": "number"
    },
    "mode": {
      "default": "search",
      "description": "Scraping mode: search or browse by category",
      "editor": "select",
      "enum": [
        "search",
        "byCategory",
        "byUrl"
      ],
      "enumTitles": [
        "Search",
        "Browse category",
        "Direct URLs"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "query": {
      "description": "Search query for recipes",
      "editor": "textfield",
      "prefill": "pasta",
      "title": "Search Query",
      "type": "string"
    },
    "startUrls": {
      "default": [],
      "description": "List of starting URLs to scrape",
      "editor": "requestListSources",
      "prefill": [],
      "title": "Start URLs",
      "type": "array"
    }
  },
  "required": [
    "mode"
  ],
  "schemaVersion": 1,
  "title": "BBC Good Food Recipe Scraper Input",
  "type": "object"
}

    "propertyUrls": {
      "default": [],
      "description": "Paste Crexi property links or IDs (e.g. https://www.crexi.com/properties/123456/name, /lease/properties/987/name, a bare ID, or a property-record link) to fetch those exact listings. A Crexi search URL (https://www.crexi.com/search/...) is also accepted and its filters are reused. Leave empty to search by the filters below.",
      "editor": "stringList",
      "prefill": [],
      "title": "Property or search URLs",
      "type": "array"
    },
    "scrapeDetails": {
      "default": false,
      "description": "Fetch each listing's detail data: broker contacts (phone and email), the broker of record when published, the full photo gallery in high resolution, investment highlights, the marketing description, published fact-sheet values, and full auction details for auction listings. Adds a few requests per listing.",
      "prefill": false,
      "title": "Enrich with full details",
      "type": "boolean"
    },
    "searchTerms": {
      "default": [],
      "description": "Free-text keywords matched against listing names, descriptions and addresses (e.g. warehouse, medical office).",
      "editor": "stringList",
      "prefill": [],
      "title": "Keywords",
      "type": "array"
    },
    "sortBy": {
      "default": "Rank",
      "description": "Order of results within each search.",
      "editor": "select",
      "enum": [

      "items": {
        "type": "string"
      },
      "title": "Place IDs or Bing Maps URLs",
      "type": "array"
    },
    "proxyConfiguration": {
      "default": {
        "useApifyProxy": true
      },
      "description": "Optional proxy. Apify Proxy AUTO is enabled by default to reduce the chance of rate limiting on large runs.",

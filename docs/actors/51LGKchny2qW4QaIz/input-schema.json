        "argentina|tierra-del-fuego",
        "argentina|la-pampa",
        "argentina|santa-cruz",
        "argentina|misiones",
        "argentina|catamarca",
        "argentina|jujuy",
        "argentina|santiago-del-estero",
        "argentina|la-rioja",
        "argentina|formosa"

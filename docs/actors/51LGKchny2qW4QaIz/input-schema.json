      "enumTitles": [
        "(none — all categories)",
        "Comercial, Ventas y Negocios",
        "Administracion, Contabilidad y Finanzas",
        "Produccion y Manufactura",
        "Abastecimiento y Logistica",
        "Oficios y Otros",
        "Atencion al Cliente, Call Center y Telemarketing",
        "Tecnologia, Sistemas y Telecomunicaciones",
        "Salud, Medicina y Farmacia",
        "Gastronomia y Turismo",
        "Ingenierias",
        "Recursos Humanos y Capacitacion",
        "Marketing y Publicidad",
        "Ingenieria Civil y Construccion",
        "Legales",
        "Secretarias y Recepcion",
        "Departamento Tecnico",
        "Diseno",
        "Gerencia y Direccion General",
        "Aduana y Comercio Exterior",
        "Educacion, Docencia e Investigacion",
        "Seguros",
        "Mineria, Petroleo y Gas",
        "Comunicacion, Relaciones Institucionales y Publicas",
        "Enfermeria",
        "Sociologia / Trabajo Social",
        "Naviero, Maritimo, Portuario"
      ],
      "prefill": "",
      "title": "Job category (area)",
      "type": "string"
    },
    "companyIds": {
      "default": [],
      "description": "Bumeran numeric company IDs, e.g. `319880` (Randstad Argentina).",
      "editor": "stringList",
      "prefill": [
        "319880"
      ],
      "title": "Company IDs (mode=byCompanyIds)",
      "type": "array"
    },
    "diasFechaPublicacion": {
      "default": "",
      "description": "Only listings published within this time window.",
      "editor": "select",
      "enum": [
        "",
        "publicacion-hoy",
        "publicacion-menor-a-2-dias",
        "publicacion-menor-a-3-dias",
        "publicacion-menor-a-4-dias",
        "publicacion-menor-a-5-dias",
        "publicacion-menor-a-6-dias",
        "publicacion-menor-a-7-dias",
        "publicacion-menor-a-15-dias",
        "publicacion-menor-a-1-mes"
      ],
      "enumTitles": [
        "(none — any time)",
        "Today",
        "Last 2 days",
        "Last 3 days",
        "Last 4 days",
        "Last 5 days",
        "Last 6 days",
        "Last week",
        "Last 15 days",
        "Last month"
      ],
      "prefill": "",
      "title": "Posted within",
      "type": "string"
    },
    "disabilityFriendlyOnly": {
      "default": false,
      "description": "Only emit listings explicitly marked accessible to people with disabilities (`apto discapacitados`).",
      "prefill": false,
      "title": "Disability-friendly only",
      "type": "boolean"
    },
    "maxItems": {
      "default": 50,
      "description": "Hard cap on emitted records.",
      "maximum": 1000,
      "minimum": 1,
      "prefill": 30,
      "title": "Max items",
      "type": "integer"
    },
    "modalidadTrabajo": {
      "default": "",
      "description": "Filter by on-site / hybrid / remote.",
      "editor": "select",
      "enum": [
        "",
        "presencial",
        "hibrido",
        "remoto"
      ],
      "enumTitles": [
        "(none — all modes)",
        "On-site (Presencial)",
        "Hybrid (Hibrido)",
        "Remote (Remoto)"
      ],
      "prefill": "",
      "title": "Work mode",
      "type": "string"
    },
    "mode": {
      "default": "search",
      "description": "What to fetch.",
      "editor": "select",
      "enum": [
        "search",
        "byCompanyIds"
      ],
      "enumTitles": [
        "Search job listings",
        "Lookup company profiles by ID"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "nivelLaboral": {
      "default": "",
      "description": "Filter by seniority / career level.",
      "editor": "select",
      "enum": [
        "",
        "semi-sr",
        "junior",
        "senior-semi-senior",
        "senior",
        "jefe-supervisor-responsable",
        "otro",
        "gerencia-alta-gerencia-direccion",
        "sin-experiencia",
        "trainee-pasante"
      ],
      "enumTitles": [
        "(none — all levels)",
        "Semi Sr",
        "Junior",
        "Senior / Semi-Senior",
        "Senior",
        "Jefe / Supervisor / Responsable",
        "Otro",
        "Gerencia / Alta Gerencia / Direccion",
        "Sin Experiencia",
        "Trainee / Pasante"
      ],
      "prefill": "",
      "title": "Seniority level",
      "type": "string"

    "quickApplyOnly": {
      "default": false,
      "description": "Only emit listings that support Bumeran's one-click quick apply.",
      "prefill": false,
      "title": "Quick-apply only",
      "type": "boolean"
    },
    "searchQuery": {
      "default": "",
      "description": "Free-text keyword search (mode=search), e.g. `programador`, `contador`, `vendedor`. Leave empty to browse all listings unfiltered.",
      "editor": "textfield",
      "prefill": "programador",
      "title": "Search query",
      "type": "string"
    },
    "segmentacionCollar": {
      "default": "",
      "description": "Filter by Bumeran's white/grey/blue-collar job classification.",
      "editor": "select",
      "enum": [
        "",
        "white",
        "grey",
        "blue",
        "indefinido"
      ],
      "enumTitles": [
        "(none — all)",
        "White Collar",
        "Grey Collar",
        "Blue Collar",
        "Indefinido"
      ],
      "prefill": "",
      "title": "Collar segmentation",
      "type": "string"
    },
    "sortBy": {
      "default": "RELEVANTES",
      "description": "Result ordering.",
      "editor": "select",
      "enum": [
        "RELEVANTES",
        "RECIENTES"
      ],
      "enumTitles": [
        "Most relevant",
        "Most recent"
      ],
      "prefill": "RELEVANTES",
      "title": "Sort by",
      "type": "string"

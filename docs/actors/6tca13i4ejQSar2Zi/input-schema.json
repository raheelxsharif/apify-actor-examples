      "maximum": 1000,
      "minimum": 1,
      "prefill": 3,
      "title": "Maximum records",
      "type": "integer"
    },
    "maxPrice": {
      "description": "Only emit products whose lowest price is at or below this value, in the site currency (USD on the English site).",
      "maximum": 100000,
      "minimum": 1,
      "title": "Maximum price",
      "type": "integer"
    },
    "minPrice": {
      "description": "Only emit products whose lowest price is at or above this value, in the site currency (USD on the English site).",
      "maximum": 100000,
      "minimum": 1,
      "title": "Minimum price",
      "type": "integer"
    },
    "minRating": {
      "description": "Only emit products rated at or above this value (1-5). Products without a rating are kept.",
      "maximum": 5,
      "minimum": 1,
      "title": "Minimum rating",
      "type": "integer"
    },
    "mode": {
      "default": "search",
      "description": "What to scrape.",
      "editor": "select",
      "enum": [
        "search",
        "browseByCity",
        "browseByCategory",
        "byUrl"
      ],
      "enumTitles": [
        "Search by keyword",
        "Browse a city",
        "Browse a category",
        "Product or list URLs"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "onSaleOnly": {
      "default": false,
      "description": "Only emit products with an active discount.",
      "prefill": false,
      "title": "Discounted products only",
      "type": "boolean"
    },
    "proxyConfiguration": {
      "description": "Optional. The actor fetches directly first and only escalates to Apify Proxy when KKday blocks the request.",
      "editor": "proxy",
      "prefill": {
        "useApifyProxy": false
      },
      "title": "Proxy configuration",
      "type": "object"
    },
    "searchQuery": {
      "default": "paris",
      "description": "Keyword or destination to search (mode=search), e.g. `tokyo disneyland`, `eiffel tower`, `paris`.",
      "editor": "textfield",
      "prefill": "paris",
      "title": "Search query",
      "type": "string"
    },
    "serviceGuarantee": {
      "description": "Only include products with this service guarantee (server-side filter).",
      "editor": "select",
      "enum": [
        "instant-confirmation",
        "easy-refund",
        "receive-voucher-instantly",
        "guaranteed-departure",
        "available-during-period"

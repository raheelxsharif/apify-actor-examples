{
  "description": "Search KKday products, browse by city/category, or fetch product details by URL.",
  "properties": {
    "category": {
      "description": "Category to browse (mode=browseByCategory).",
      "editor": "select",
      "enum": [
        "attractions",
        "museum",
        "theme-park",
        "food",
        "sightseeing-tour",
        "day-trip",
        "cruise",
        "water-activity",
        "sports",
        "transportation",
        "wifi-sim",
        "spa"
      ],
      "enumTitles": [
        "Attractions",
        "Museum",
        "Theme Park",
        "Food & Dining",
        "Sightseeing Tour",
        "Day Trip",
        "Cruise",
        "Water Activity",
        "Sports & Outdoor",
        "Transportation",
        "eSIM / WiFi / SIM",
        "Spa & Wellness"
      ],
      "prefill": "attractions",
      "title": "Category",
      "type": "string"
    },
    "city": {
      "description": "City to browse (mode=browseByCity).",
      "editor": "select",
      "enum": [
        "paris",
        "london",
        "rome",
        "barcelona",

        "manila",
        "sydney",
        "melbourne",
        "new-york",
        "los-angeles",
        "las-vegas",
        "dubai",
        "istanbul"
      ],
      "enumTitles": [
        "Paris",
        "London",
        "Rome",
        "Barcelona",
        "Madrid",
        "Tokyo",
        "Osaka",
        "Kyoto",
        "Hokkaido",
        "Seoul",

        "Easy Refund",
        "Receive Voucher Instantly",
        "Guaranteed Departure",
        "Available During Period"
      ],
      "title": "Service guarantee",
      "type": "string"
    },
    "sortBy": {
      "default": "relevance",
      "description": "Result ordering. KKday does not expose price-descending.",
      "editor": "select",
      "enum": [
        "relevance",
        "popularity",
        "rating",
        "price-asc"
      ],
      "enumTitles": [
        "KKday relevance",
        "Most booked",
        "Top rated",
        "Price: low to high"
      ],
      "prefill": "relevance",
      "title": "Sort by",
      "type": "string"
    },
    "startUrls": {
      "default": [],
      "description": "Product detail URLs, or KKday search/city/category list URLs (mode=byUrl). Duplicates are fetched once.",
      "editor": "stringList",
      "prefill": [],
      "title": "Product or list URLs",
      "type": "array"
    },
    "trustedPartnerOnly": {
      "default": false,
      "description": "Only include products from KKday's certified Trusted Partners.",
      "prefill": false,
      "title": "Trusted partners only",
      "type": "boolean"
    }

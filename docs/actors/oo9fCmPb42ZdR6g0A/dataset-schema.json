{
  "actorSpecification": 1,
  "fields": {
    "properties": {
      "accessibility_caption": {
        "description": "Alt text Instagram describes the post with",
        "type": "string"
      },
      "author_meta": {
        "description": "Author details: id, username, full_name, is_verified, profile_pic_url and profile_url",
        "type": "object"
      },
      "caption": {
        "description": "Caption text",
        "type": "string"
      },
      "caption_is_edited": {
        "description": "Whether the caption was edited after posting",
        "type": "boolean"
      },
      "collaborators": {
        "description": "Usernames of the invited collaborators on the post",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "comment_count": {
        "description": "Number of comments",
        "type": "integer"
      },
      "comments_disabled": {
        "description": "Whether comments are turned off",
        "type": "boolean"
      },
      "hashtags": {
        "description": "Hashtags used in the caption",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "like_count": {
        "description": "Number of likes, or null when the owner hides them",
        "type": [
          "integer",
          "null"
        ]
      },
      "likes_hidden": {
        "description": "Whether the owner hides the like count",
        "type": "boolean"
      },
      "location": {
        "description": "Tagged place: name, id, lat and lng, or null",
        "type": [
          "object",
          "null"
        ]
      },
      "media_count": {
        "description": "Number of photos and videos in the post",
        "type": "integer"
      },
      "media_items": {
        "description": "Each photo or video: index, type, url, width, height, id, shortcode, accessibility_caption and, for videos, duration and has_audio",
        "items": {
          "type": "object"
        },
        "type": "array"
      },
      "media_type": {
        "description": "Photo, Video, Reel or Carousel",
        "type": "string"
      },
      "mentions": {
        "description": "Usernames mentioned in the caption",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "music": {
        "description": "Reel audio: artist, title, audio_id, audio_url, cover_url and is_trending, or null",
        "type": [
          "object",
          "null"
        ]
      },
      "post_id": {
        "description": "Instagram's numeric id of the post",
        "type": "string"
      },
      "post_url": {
        "description": "Link to the post on Instagram",
        "type": "string"
      },
      "pub_date": {
        "description": "When the post was published (ISO 8601)",
        "type": "string"
      },
      "scraped_at": {
        "description": "When the post was scraped (ISO 8601)",
        "type": "string"
      },
      "shortcode": {
        "description": "The short code in the post link",
        "type": "string"
      },
      "status": {
        "description": "success, or why the post has no data: not_found, age_restricted, is_private, blocked, error or invalid_url",
        "type": "string"
      },
      "tagged_users": {
        "description": "Usernames of the people tagged in the post",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "thumbnail_url": {
        "description": "Link to the cover image",
        "type": "string"
      },
      "username": {
        "description": "Username of the account that posted",
        "type": "string"
      }
    },
    "type": "object"
  },

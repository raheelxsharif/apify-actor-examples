{
  "description": "Search Geizhals products, compare prices, or browse hardware categories on geizhals.at and sister sites.",
  "properties": {
    "category": {
      "default": "nb",
      "description": "Geizhals category to browse.",
      "editor": "select",
      "enum": [
        "nb",
        "cpu",
        "gra",
        "ram",
        "hd",
        "monitor",
        "keyboard",
        "mouse",
        "printer",
        "usb"
      ],
      "enumTitles": [
        "Notebooks / Laptops",
        "Processors (CPU)",
        "Graphics Cards (GPU)",
        "RAM / Memory",
        "Hard Drives & SSDs",
        "Monitors",
        "Keyboards",
        "Mice",
        "Printers",
        "USB Devices"
      ],
      "prefill": "nb",
      "title": "Category (mode=categoryBrowse)",
      "type": "string"
    },
    "country": {
      "default": "at",
      "description": "Geizhals country site to use.",
      "editor": "select",
      "enum": [
        "at",
        "de",
        "pl",
        "uk"
      ],
      "enumTitles": [
        "Austria (geizhals.at)",
        "Germany (geizhals.de)",
        "Poland (geizhals.pl)",
        "United Kingdom (skinflint.co.uk)"
      ],
      "prefill": "at",
      "title": "Country site",
      "type": "string"
    },
    "keyword": {
      "default": "monitor",
      "description": "Keyword to search for (mode=search or categoryBrowse).",
      "editor": "textfield",
      "prefill": "monitor",
      "title": "Search keyword",
      "type": "string"
    },
    "maxItems": {
      "default": 20,
      "description": "Maximum number of products to return.",
      "maximum": 500,
      "minimum": 1,
      "prefill": 20,
      "title": "Max items",
      "type": "integer"
    },
    "mode": {
      "default": "search",
      "description": "What to scrape.",
      "editor": "select",
      "enum": [
        "search",
        "productPrices",
        "categoryBrowse"
      ],
      "enumTitles": [
        "Search products by keyword",
        "Get price comparison for product URLs",
        "Browse products by category"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "productUrls": {
      "default": [],
      "description": "List of Geizhals product comparison page URLs.",
      "editor": "stringList",
      "prefill": [],
      "title": "Product URLs (mode=productPrices)",
      "type": "array"
    }
  },
  "required": [
    "mode"
  ],
  "schemaVersion": 1,
  "title": "Geizhals Scraper Input",
  "type": "object"
}

    "maxItems": {
      "default": 5000,
      "description": "Global cap on suggestion rows across all seeds and sources.",
      "maximum": 50000,
      "minimum": 1,
      "prefill": 3,
      "title": "Maximum rows",
      "type": "integer"
    },
    "maxLength": {
      "description": "Drop suggestions longer than this many characters.",
      "maximum": 500,
      "minimum": 1,
      "title": "Maximum length",
      "type": "integer"
    },
    "maxQueriesPerSeed": {
      "default": 300,
      "description": "Cap on autocomplete requests per seed and source. Exact stays one request.",
      "maximum": 1000,
      "minimum": 1,
      "prefill": 300,
      "title": "Maximum queries per seed",
      "type": "integer"
    },
    "maxSuggestionsPerSeed": {
      "default": 2000,
      "description": "Cap on rows kept for each seed after the expansion plan runs.",
      "maximum": 10000,
      "minimum": 1,
      "prefill": 3,
      "title": "Maximum suggestions per seed",
      "type": "integer"
    },
    "minLength": {
      "description": "Drop suggestions shorter than this many characters.",
      "maximum": 200,
      "minimum": 1,
      "title": "Minimum length",
      "type": "integer"
    },
    "minWordCount": {
      "default": 0,
      "description": "Drop suggestions with fewer words than this.",
      "maximum": 20,
      "minimum": 0,
      "prefill": 0,
      "title": "Minimum word count",
      "type": "integer"
    },
    "mode": {
      "default": "exact",
      "description": "How far to expand each seed. Exact is one request; All runs every working expansion axis.",
      "editor": "select",
      "enum": [
        "all",
        "exact",
        "alphabet",
        "questions",
        "modifiers",
        "prepositions",
        "comparisons",
        "related"
      ],
      "enumTitles": [
        "All expansions",
        "Exact seed",
        "Alphabet (suffix + prefix, a-z + 0-9)",
        "Questions (locale-aware, prefix + suffix)",
        "Video modifiers (shorts, video, tutorial, ...)",
        "Prepositions",
        "Comparisons",
        "Related (trailing space, wildcard, review, ...)"
      ],
      "prefill": "exact",
      "title": "Expansion mode",
      "type": "string"
    },
    "mustContainSeed": {
      "default": false,
      "description": "Keep only suggestions that contain the seed keyword.",
      "prefill": false,
      "title": "Must contain seed",
      "type": "boolean"
    },
    "onlyQuestions": {
      "default": false,
      "description": "Keep only suggestions that look like questions.",
      "prefill": false,
      "title": "Only questions",
      "type": "boolean"
    },
    "queries": {
      "default": [
        "web scraping"
      ],
      "description": "Keywords or phrases to expand with YouTube autocomplete. Short 1-3 word seeds work best.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "prefill": [
        "web scraping"
      ],
      "title": "Seed queries",
      "type": "array"
    },
    "source": {
      "default": "youtube",
      "description": "YouTube search, YouTube Music, or both. YouTube Music is a separate music-biased source.",
      "editor": "select",
      "enum": [
        "youtube",
        "youtubeMusic",
        "both"
      ],
      "enumTitles": [
        "YouTube search",
        "YouTube Music",
        "Both sources"
      ],
      "prefill": "youtube",
      "title": "Suggestion source",
      "type": "string"
    }
  },
  "required": [
    "queries"
  ],
  "schemaVersion": 1,
  "title": "YouTube Search Suggestions Scraper Input",
  "type": "object"
}

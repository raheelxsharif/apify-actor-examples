{
  "description": "Collect YouTube's live search autocomplete for seed queries, with optional A-Z, question and modifier expansion.",
  "properties": {
    "containsKeyword": {
      "description": "Keep suggestions containing this text. Prefix with ! to exclude it instead.",
      "editor": "textfield",
      "title": "Contains keyword",
      "type": "string"
    },
    "dedupeAcrossSeeds": {
      "default": false,
      "description": "Keep one row when the same suggestion appears for more than one seed. Per-seed duplicates are always removed.",
      "prefill": false,
      "title": "Remove duplicates across seeds",
      "type": "boolean"
    },
    "excludeTerms": {
      "default": [],
      "description": "Drop suggestions containing any of these terms.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": [],
      "title": "Exclude terms",
      "type": "array"
    },
    "expansionDepth": {
      "default": 0,
      "description": "0 = selected mode only. 1-2 re-query the best suggestions for deeper long-tail coverage.",
      "maximum": 2,
      "minimum": 0,
      "prefill": 0,
      "title": "Recursion depth",
      "type": "integer"
    },
    "includeEntityCards": {
      "default": true,
      "description": "Keep channel and topic suggestions, with their entity metadata, when YouTube returns them.",
      "prefill": true,
      "title": "Include channel and topic cards",
      "type": "boolean"
    },
    "includeSearchUrl": {
      "default": true,
      "description": "Add a ready-to-open YouTube or YouTube Music search URL to every row.",
      "prefill": true,
      "title": "Include search links",
      "type": "boolean"
    },

      ],
      "prefill": "metro-manila",
      "title": "Region / province",
      "type": "string"
    },
    "sortBy": {
      "default": "popularity",
      "description": "Order in which listings are returned. Only applies to mode=search.",
      "editor": "select",
      "enum": [
        "popularity",
        "newest",
        "price-low",
        "price-high"
      ],
      "enumTitles": [
        "Popular (default)",
        "Newest first",
        "Price: low to high",
        "Price: high to low"
      ],
      "prefill": "popularity",
      "title": "Sort order (mode=search)",
      "type": "string"
    },
    "transactionType": {
      "default": "buy",
      "description": "Whether to fetch listings for sale or for rent.",
      "editor": "select",
      "enum": [
        "buy",
        "rent"
      ],
      "enumTitles": [
        "For Sale",
        "For Rent"
      ],
      "prefill": "buy",
      "title": "For sale or for rent",
      "type": "string"
    }
  },
  "required": [
    "mode",
    "transactionType",
    "propertyType"
  ],
  "schemaVersion": 1,
  "title": "Lamudi Real Estate Scraper Input",
  "type": "object"
}

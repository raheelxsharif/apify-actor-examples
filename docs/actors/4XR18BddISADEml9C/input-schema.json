      "minimum": 1,
      "prefill": 3,
      "title": "Max comments per video",
      "type": "integer"
    },
    "maxItems": {
      "default": 1000000,
      "description": "Global cap on dataset rows. The default is effectively unlimited for backward compatibility.",
      "maximum": 1000000,
      "minimum": 1,
      "prefill": 3,
      "title": "Max rows",
      "type": "integer"
    },
    "maxVideosPerSource": {
      "default": 50,
      "description": "For username, topic and feed modes, stop after this many Spotlight videos per source. Ignored for explicit URLs.",
      "maximum": 100,
      "minimum": 1,
      "prefill": 1,
      "title": "Max videos per source",
      "type": "integer"
    },
    "mode": {
      "default": "byUsername",
      "description": "Choose what to scrape: specific Spotlight videos, creator profiles, hashtags/topics, or the trending country feed.",
      "editor": "select",
      "enum": [
        "bySpotlightUrls",
        "byUsername",
        "byTopic",
        "byFeed"
      ],
      "enumTitles": [
        "Spotlight URLs or IDs",
        "Creator usernames",
        "Hashtags / topics",
        "Trending feed by country"
      ],
      "prefill": "byUsername",
      "title": "Mode",
      "type": "string"
    },
    "spotlightUrls": {
      "description": "(mode=bySpotlightUrls) One or more Spotlight URLs, @user/spotlight links, t.snapchat.com links, or raw snap IDs.",
      "editor": "stringList",
      "title": "Spotlight URLs or IDs",
      "type": "array"
    },
    "topics": {
      "default": [
        "food"
      ],
      "description": "(mode=byTopic) Hashtags or topics, or /tag, /explore and /topic URLs.",
      "editor": "stringList",
      "prefill": [
        "food"
      ],
      "title": "Hashtags or topics",
      "type": "array"
    },
    "usernames": {
      "default": [
        "brentrivera"
      ],
      "description": "(mode=byUsername) Snapchat usernames, @names, /add/name or /@name profile URLs.",
      "editor": "stringList",
      "prefill": [
        "brentrivera"
      ],
      "title": "Creator usernames",
      "type": "array"
    }
  },
  "required": [
    "mode"
  ],
  "schemaVersion": 1,
  "title": "Snapchat Spotlight Comments Scraper",

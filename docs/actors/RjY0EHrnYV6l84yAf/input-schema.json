{
  "description": "Search 4,278 Washington Trails Association hikes, fetch trail details, or stream trail-level and global trip reports.",
  "properties": {
    "author": {
      "description": "Exact WTA author username (mode searchTripReports).",
      "editor": "textfield",
      "title": "Report author",
      "type": "string"
    },
    "boundingBox": {
      "description": "Map area as `south,west,north,east` (mode searchTrails). Takes priority over latitude/longitude/radius.",
      "editor": "textfield",
      "title": "Bounding box",
      "type": "string"
    },
    "dogPolicy": {
      "default": "any",
      "description": "Filter by dog access (mode searchTrails).",
      "editor": "select",
      "enum": [
        "any",
        "allowed-on-leash",
        "not-allowed"
      ],
      "enumTitles": [
        "Any dog policy",
        "Dogs allowed on leash",
        "Dogs not allowed"
      ],
      "prefill": "any",
      "title": "Dog policy",
      "type": "string"
    },
    "features": {
      "default": [],
      "description": "Require all selected features (mode searchTrails). Empty = no feature filter.",
      "editor": "select",
      "items": {
        "enum": [
          "Coast",
          "Rivers",
          "Lakes",
          "Waterfalls",
          "Old growth",
          "Fall foliage",
          "Wildflowers/Meadows",
          "Mountain views",
          "Summits",
          "Wildlife",
          "Ridges/passes",
          "Established campsites"
        ],
        "enumTitles": [
          "Coast",
          "Rivers",
          "Lakes",
          "Waterfalls",
          "Old growth",
          "Fall foliage",
          "Wildflowers/Meadows",
          "Mountain views",
          "Summits",
          "Wildlife",
          "Ridges/passes",
          "Established campsites"
        ],
        "type": "string"
      },
      "prefill": [],
      "title": "Trail features",
      "type": "array",
      "uniqueItems": true
    },
    "fetchDetails": {
      "default": false,
      "description": "Add difficulty, description, parking pass, land manager, directions, alerts and trip-report count with one detail page per trail (modes searchTrails, getTripReports).",
      "prefill": false,
      "title": "Fetch trail details",
      "type": "boolean"
    },
    "fetchReportDetails": {
      "default": false,
      "description": "Open each report page for trail URL, hike type, trail/road/bug/snow conditions and full photo URLs (mode searchTripReports).",
      "prefill": false,
      "title": "Fetch report details",
      "type": "boolean"
    },
    "hikeTypes": {
      "default": [],
      "description": "Keep reports matching any selected hike type (mode searchTripReports).",
      "editor": "select",
      "items": {
        "enum": [
          "day-hike",
          "overnight",
          "multi-night-backpack",
          "snowshoe-xc-ski"
        ],
        "enumTitles": [
          "Day hike",
          "Overnight",
          "Multi-night backpack",
          "Snowshoe / XC ski"
        ],
        "type": "string"
      },
      "prefill": [],
      "title": "Hike types",
      "type": "array",
      "uniqueItems": true
    },
    "includeReportText": {
      "default": false,
      "description": "Attach full text and tags to the recent reports (mode getTripReports; up to 5 per trail).",
      "prefill": false,
      "title": "Include report text",
      "type": "boolean"
    },
    "kidFriendly": {
      "default": false,
      "description": "Only kid-friendly trails (mode searchTrails).",
      "prefill": false,
      "title": "Good for kids",
      "type": "boolean"
    },
    "latitude": {
      "description": "Center latitude for a radius search (mode searchTrails). Requires longitude and radiusMiles.",
      "maximum": 90,
      "minimum": -90,
      "title": "Latitude",
      "type": "number"
    },
    "longitude": {
      "description": "Center longitude for a radius search (mode searchTrails). Requires latitude and radiusMiles.",
      "maximum": 180,
      "minimum": -180,
      "title": "Longitude",
      "type": "number"
    },
    "maxElevationGainFeet": {
      "description": "Only trails with at most this gain (mode searchTrails). Unknown gain is excluded.",
      "maximum": 30000,
      "minimum": 0,
      "title": "Maximum elevation gain (ft)",
      "type": "integer"
    },
    "maxHighPointFeet": {
      "description": "Only trails whose highest point is at most this elevation (mode searchTrails).",
      "maximum": 15000,
      "minimum": 0,
      "title": "Maximum high point (ft)",
      "type": "integer"
    },
    "maxItems": {
      "default": 50,
      "description": "Hard cap on emitted records.",
      "maximum": 10000,
      "minimum": 1,
      "prefill": 3,
      "title": "Max items",
      "type": "integer"
    },
    "maxLengthMiles": {
      "description": "Only trails at most this long (mode searchTrails). Trails with unknown length are excluded.",
      "maximum": 200,
      "minimum": 0,
      "title": "Maximum length (miles)",
      "type": "number"
    },
    "minElevationGainFeet": {
      "description": "Only trails with at least this gain (mode searchTrails). Unknown gain is excluded.",
      "maximum": 30000,
      "minimum": 0,
      "title": "Minimum elevation gain (ft)",
      "type": "integer"
    },
    "minLengthMiles": {
      "description": "Only trails at least this long (mode searchTrails). Trails with unknown length are excluded.",
      "maximum": 200,
      "minimum": 0,
      "title": "Minimum length (miles)",
      "type": "number"
    },
    "minRating": {
      "description": "Minimum average community rating, 0–5 (mode searchTrails).",
      "maximum": 5,
      "minimum": 0,
      "title": "Minimum rating",
      "type": "number"
    },
    "minVoteCount": {
      "description": "Minimum number of rating votes (mode searchTrails; applied after the listing fetch).",
      "maximum": 100000,
      "minimum": 0,
      "title": "Minimum rating votes",
      "type": "integer"
    },
    "mode": {
      "default": "searchTrails",
      "description": "What to fetch from wta.org.",
      "editor": "select",
      "enum": [
        "searchTrails",
        "getTrailDetails",
        "getTripReports",
        "searchTripReports"
      ],
      "enumTitles": [
        "Search trails",
        "Get trail details by URL",
        "Get trip reports for trails",
        "Search trip reports"
      ],
      "prefill": "searchTrails",
      "title": "Mode",
      "type": "string"
    },
    "nameQuery": {
      "description": "Match the hike name only (modes searchTrails, getTripReports, searchTripReports).",
      "editor": "textfield",
      "title": "Hike name",
      "type": "string"
    },
    "passes": {
      "default": [],
      "description": "Keep trails that require at least one selected pass (mode searchTrails). Empty = no pass filter.",
      "editor": "select",
      "items": {
        "enum": [
          "none",
          "discover-pass",
          "national-park-pass",
          "northwest-forest-pass",
          "interagency-pass",
          "oregon-state-parks-day-use",
          "sno-parks-permit"
        ],
        "enumTitles": [
          "No pass",
          "Discover Pass",
          "National Park pass",
          "Northwest Forest Pass",
          "Interagency pass",
          "Oregon State Parks day-use",
          "Sno-Parks permit"
        ],
        "type": "string"
      },
      "prefill": [],
      "title": "Required pass",
      "type": "array",
      "uniqueItems": true
    },
    "proxyConfiguration": {
      "description": "Optional override. The actor works without any proxy.",
      "editor": "proxy",
      "title": "Proxy configuration (optional)",
      "type": "object"
    },
    "radiusMiles": {
      "description": "Search radius in miles (mode searchTrails).",
      "maximum": 200,
      "minimum": 1,
      "title": "Radius (miles)",
      "type": "number"
    },
    "region": {
      "description": "Washington region. Choose All Washington to search statewide (modes searchTrails, getTripReports, searchTripReports).",
      "editor": "select",
      "enum": [
        "all",
        "Central Cascades",
        "Central Washington",
        "Eastern Washington",
        "Issaquah Alps",
        "Mount Rainier Area",
        "North Cascades",
        "Olympic Peninsula",
        "Puget Sound and Islands",
        "Snoqualmie Region",
        "South Cascades",
        "Southwest Washington"
      ],
      "enumTitles": [
        "All Washington",
        "Central Cascades",
        "Central Washington",
        "Eastern Washington",
        "Issaquah Alps",
        "Mount Rainier Area",
        "North Cascades",
        "Olympic Peninsula",
        "Puget Sound and Islands",
        "Snoqualmie Region",
        "South Cascades",
        "Southwest Washington"
      ],
      "prefill": "Snoqualmie Region",
      "title": "Region",
      "type": "string"
    },
    "reportFeatures": {
      "default": [],
      "description": "Keep reports matching any selected feature (mode searchTripReports).",
      "editor": "select",
      "items": {
        "enum": [
          "has-photos",
          "hiked-by-kids",
          "hiked-with-dog",
          "was-workparty"
        ],
        "enumTitles": [
          "Has photos",
          "Hiked by kids",
          "Hiked with a dog",
          "Was a work party"
        ],
        "type": "string"
      },
      "prefill": [],
      "title": "Report features",
      "type": "array",
      "uniqueItems": true
    },
    "reportHighlights": {
      "default": [],
      "description": "Keep reports mentioning any selected highlight (mode searchTripReports).",
      "editor": "select",
      "items": {
        "enum": [
          "wildflowers-blooming",
          "fall-foliage",
          "ripe-berries"
        ],
        "enumTitles": [
          "Wildflowers blooming",
          "Fall foliage",
          "Ripe berries"
        ],
        "type": "string"
      },
      "prefill": [],
      "title": "Report highlights",
      "type": "array",
      "uniqueItems": true
    },
    "reportRecency": {
      "default": "anytime",
      "description": "Filter by how recently a trail received a trip report (mode searchTrails).",
      "editor": "select",
      "enum": [
        "anytime",
        "30-to-90-days",
        "90-plus-days"

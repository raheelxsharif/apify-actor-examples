      "items": {
        "enum": [
          "all-vehicles",
          "high-clearance",
          "impassable"
        ],
        "enumTitles": [
          "All vehicles",
          "High clearance",
          "Impassable"
        ],
        "type": "string"
      },
      "prefill": [],
      "title": "Road conditions",
      "type": "array",
      "uniqueItems": true
    },
    "searchQuery": {
      "description": "Free-text search of WTA hike descriptions (modes searchTrails, searchTripReports).",
      "editor": "textfield",
      "title": "Full-text query",
      "type": "string"
    },
    "sortBy": {
      "default": "recently-updated",
      "description": "Result order (mode searchTrails).",
      "editor": "select",
      "enum": [
        "recently-updated",
        "rating",
        "difficulty",
        "mileage",
        "elevation-gain",
        "high-point",

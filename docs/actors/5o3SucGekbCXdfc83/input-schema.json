{
  "description": "Search products, get details, browse categories, or find promotions on Bol.com.",
  "properties": {
    "categoryId": {
      "description": "Bol.com category ID to browse (e.g. 11776).",
      "editor": "textfield",
      "title": "Category ID (mode=categoryBrowse)",
      "type": "string"
    },
    "keyword": {
      "default": "laptop",
      "description": "Product search keyword (mode=search).",
      "editor": "textfield",
      "prefill": "laptop",
      "title": "Search keyword",
      "type": "string"
    },
    "maxItems": {
      "default": 20,
      "description": "Maximum number of products to return.",
      "maximum": 500,
      "minimum": 1,
      "prefill": 20,
      "title": "Max items",
      "type": "integer"
    },
    "mode": {
      "default": "search",
      "description": "What to fetch from Bol.com.",
      "editor": "select",
      "enum": [
        "search",
        "productDetails",
        "categoryBrowse",
        "promotions"
      ],
      "enumTitles": [
        "Search products by keyword",
        "Fetch product details by URL or EAN",
        "Browse products by category",
        "Browse current promotions"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "productUrls": {
      "default": [],
      "description": "List of Bol.com product page URLs or EAN codes.",
      "editor": "stringList",
      "prefill": [],
      "title": "Product URLs or EANs (mode=productDetails)",
      "type": "array"
    },
    "sortBy": {
      "default": "RELEVANCE",
      "description": "How to sort search results.",
      "editor": "select",
      "enum": [
        "RELEVANCE",
        "PRICE_ASC",
        "PRICE_DESC",
        "RATING_ASC",
        "NEW"
      ],
      "enumTitles": [
        "Relevance",
        "Price: Low to High",
        "Price: High to Low",
        "Best rated",
        "Newest"
      ],
      "prefill": "RELEVANCE",
      "title": "Sort by",
      "type": "string"
    }
  },
  "required": [
    "mode"
  ],
  "schemaVersion": 1,
  "title": "Bol.com Scraper Input",
  "type": "object"
}

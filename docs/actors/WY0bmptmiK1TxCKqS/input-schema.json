      "default": 20,
      "description": "Maximum number of company records to return.",
      "maximum": 500,
      "minimum": 1,
      "prefill": 20,
      "title": "Max items",
      "type": "integer"
    },
    "mode": {
      "default": "searchCompanies",
      "description": "What to search for on Kompass.",
      "editor": "select",
      "enum": [
        "searchCompanies",
        "searchByProduct",
        "searchByCountry",
        "companyDetails"
      ],
      "enumTitles": [
        "Search companies by query",
        "Search companies by product/service",

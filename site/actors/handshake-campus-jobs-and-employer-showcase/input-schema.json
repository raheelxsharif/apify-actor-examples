{
  "description": "Scrape public Handshake jobs by keyword, role, city, or URL, plus public employer profiles with industry, size and reviews.",
  "properties": {
    "companyFilter": {
      "default": "",
      "description": "Keep jobs whose employer name contains this text.",
      "editor": "textfield",
      "prefill": "",
      "title": "Company contains",
      "type": "string"
    },
    "employerQuery": {
      "default": "",

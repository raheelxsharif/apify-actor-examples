    "maxEmployers": {
      "default": 100,
      "description": "Maximum employer records to return (mode=employers).",
      "maximum": 50000,
      "minimum": 1,
      "prefill": 1,
      "title": "Max employers",
      "type": "integer"
    },
    "maxItems": {
      "default": 50,
      "description": "Maximum job records to return.",
      "maximum": 1000,
      "minimum": 1,
      "prefill": 1,
      "title": "Max jobs",
      "type": "integer"
    },
    "maxReviewsPerEmployer": {
      "default": 5,
      "description": "Maximum recent public reviews to keep per employer profile (mode=employers, includeReviews=true).",
      "maximum": 100,
      "minimum": 1,
      "prefill": 1,
      "title": "Max reviews per employer",
      "type": "integer"
    },
    "minSalary": {
      "description": "Keep jobs whose published maximum pay is at least this amount. Compare with the pay period selected below.",
      "maximum": 1000000,
      "minimum": 0,
      "title": "Minimum salary",
      "type": "integer"
    },
    "mode": {
      "default": "searchJobs",
      "description": "What to scrape.",
      "editor": "select",
      "enum": [
        "searchJobs",
        "byJobUrls",
        "bySearchUrls",
        "bySitemap",
        "employers",
        "internships",
        "companyListings"
      ],
      "enumTitles": [
        "Search public jobs",
        "Look up job URLs or IDs",
        "Scrape find-jobs search URLs",
        "Scan the public jobs sitemap",
        "Scrape employer showcase",
        "Legacy: internships (maps to searchJobs + internshipsOnly)",
        "Legacy: company listings (maps to employers)"
      ],
      "prefill": "searchJobs",
      "title": "Mode",
      "type": "string"
    },
    "onlyNewJobs": {
      "default": false,
      "description": "Return only job IDs not seen in previous runs (mode=searchJobs/bySearchUrls/bySitemap).",
      "prefill": false,
      "title": "Only new jobs",
      "type": "boolean"
    },
    "postedWithinDays": {
      "description": "Keep jobs posted in the last N days (1-365). Leave empty for any date.",
      "maximum": 365,
      "minimum": 1,
      "title": "Posted within days",
      "type": "integer"
    },
    "resetMonitoringState": {
      "default": false,
      "description": "Clear the saved seen-job list before this run.",
      "prefill": false,
      "title": "Reset seen-job state",
      "type": "boolean"
    },
    "salaryPeriod": {
      "default": "any",
      "description": "Restrict to jobs with pay published per year, month or hour.",
      "editor": "select",
      "enum": [
        "any",
        "year",
        "month",
        "hour"
      ],
      "enumTitles": [
        "Any pay period",
        "Per year",
        "Per month",
        "Per hour"
      ],
      "prefill": "any",
      "title": "Pay period",
      "type": "string"
    },
    "searchQuery": {
      "default": "",
      "description": "Words matched against job titles and descriptions (mode=searchJobs/bySearchUrls). Leave empty to browse.",
      "editor": "textfield",
      "prefill": "",
      "title": "Keyword",
      "type": "string"
    },
    "searchUrls": {
      "default": [],
      "description": "Public joinhandshake.com/find-jobs/ or /internships/ listing URLs (mode=bySearchUrls).",
      "editor": "requestListSources",
      "items": {
        "properties": {
          "url": {
            "description": "Public URL",
            "title": "URL",
            "type": "string"
          }
        },
        "type": "object"
      },
      "prefill": [],
      "title": "Search URLs",
      "type": "array"

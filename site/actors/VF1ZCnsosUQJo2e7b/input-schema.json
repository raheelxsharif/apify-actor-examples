{
  "description": "Search Myntra products, browse by category or brand, or fetch full product pages.",
  "properties": {
    "brandName": {
      "description": "Brand to browse (mode=browseByBrand). Use the brand as it appears on Myntra, e.g. `adidas`, `nike`, `levis`, `tommy hilfiger`, `roadster`. Spaces and special characters are slugified automatically.",
      "editor": "textfield",
      "title": "Brand (mode=browseByBrand)",
      "type": "string"
    },
    "category": {
      "default": "tshirts",
      "description": "Myntra category to browse (mode=browseByCategory).",
      "editor": "select",
      "enum": [
        "tshirts",
        "shirts",
        "jeans",
        "trousers",
        "shorts",
        "trackpants",
        "sweatshirts",
        "sweaters",

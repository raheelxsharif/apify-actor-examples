    "publishedFrom": {
      "description": "Optional ISO date/time lower bound for firstPublishedAt.",
      "editor": "textfield",
      "title": "Published From",
      "type": "string"
    },
    "quotaCoverageType": {
      "description": "Keep sales roles with this quota-coverage classification. Jobs without a quota classification are excluded when this filter is set.",
      "editor": "select",
      "enum": [
        "Account Executive",
        "Overlay",
        "Overlay Quota Rep (OQR)"
      ],
      "enumTitles": [
        "Account Executive",
        "Overlay",
        "Overlay Quota Rep (OQR)"
      ],
      "title": "Quota Coverage Type",
      "type": "string"
    },
    "remoteOnly": {
      "default": false,
      "description": "Keep only postings whose location is listed as remote.",
      "prefill": false,
      "title": "Remote Only",
      "type": "boolean"
    },
    "searchQuery": {
      "description": "Keyword used by searchJobs mode. Matches the job title, company, location, requisition ID, department, and division (case-insensitive).",
      "editor": "textfield",
      "prefill": "engineer",
      "title": "Search Query",
      "type": "string"
    },
    "sortBy": {
      "default": "firstPublishedDesc",
      "description": "Sort order for job list modes.",
      "editor": "select",
      "enum": [
        "firstPublishedDesc",
        "firstPublishedAsc",
        "updatedDesc",
        "updatedAsc",
        "titleAsc",
        "titleDesc"
      ],
      "enumTitles": [
        "Newest published first",
        "Oldest published first",
        "Recently updated first",
        "Oldest updated first",
        "Title A-Z",
        "Title Z-A"
      ],
      "prefill": "firstPublishedDesc",
      "title": "Sort By",
      "type": "string"
    },
    "updatedFrom": {
      "description": "Optional ISO date/time lower bound for updatedAt.",
      "editor": "textfield",
      "title": "Updated From",
      "type": "string"

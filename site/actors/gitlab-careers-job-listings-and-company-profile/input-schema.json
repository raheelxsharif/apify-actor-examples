    "fetchFullDescription": {
      "default": true,
      "description": "Include the job description as HTML and plain text, section headings, outbound links, and compliance types.",
      "prefill": true,
      "title": "Fetch Full Description",
      "type": "boolean"
    },
    "includeFutureOpportunities": {
      "default": false,
      "description": "Also include GitLab's expression-of-interest forms for future roles when listing open jobs.",
      "prefill": false,
      "title": "Include Future Opportunities",
      "type": "boolean"
    },
    "jobIds": {
      "description": "Exact Greenhouse job IDs for byJobIds mode. Both GitLab boards are checked.",
      "editor": "stringList",
      "title": "Job IDs",
      "type": "array"
    },
    "jobUrls": {
      "description": "Exact Greenhouse job URLs for byJobUrls mode. Accepts job-boards.greenhouse.io and boards.greenhouse.io links for the gitlab and gitlabcrm boards.",
      "editor": "stringList",
      "title": "Job URLs",
      "type": "array"
    },
    "locationContains": {
      "description": "Optional case-insensitive location substring filter, for example Italy, Remote, EMEA, or United States.",
      "editor": "textfield",
      "title": "Location Contains",
      "type": "string"
    },
    "maxItems": {
      "default": 5,
      "description": "Maximum job records to emit (company profile mode always emits one record).",
      "editor": "number",
      "maximum": 5000,
      "minimum": 1,
      "prefill": 5,
      "title": "Max Items",
      "type": "integer"
    },
    "mode": {
      "default": "searchJobs",
      "description": "Choose how to collect GitLab data: search open roles, list all open roles, filter by department, resolve exact job IDs or URLs, list future-opportunity forms, or read the GitLab careers profile.",
      "editor": "select",
      "enum": [
        "searchJobs",
        "allJobs",
        "byDepartment",
        "byJobIds",
        "byJobUrls",
        "futureOpportunities",
        "companyProfile"
      ],
      "enumTitles": [
        "Search open jobs",
        "All open jobs",
        "Jobs in a department",
        "Exact job IDs",
        "Exact job URLs",
        "Future opportunities",
        "Company profile"
      ],
      "prefill": "searchJobs",
      "title": "Mode",
      "type": "string"
    },

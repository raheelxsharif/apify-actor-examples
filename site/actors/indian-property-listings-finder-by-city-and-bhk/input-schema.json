      "description": "Highest asking price in Indian Rupees (mode=searchForSale, searchForRent, searchProperties).",
      "maximum": 1000000000000,
      "minimum": 0,
      "title": "Maximum price (INR)",
      "type": "integer"
    },
    "priceMin": {
      "description": "Lowest asking price in Indian Rupees (mode=searchForSale, searchForRent, searchProperties).",
      "maximum": 1000000000000,
      "minimum": 0,
      "title": "Minimum price (INR)",
      "type": "integer"
    },
    "propertyType": {
      "default": "Apartment",
      "description": "Type of property to search (mode=searchForSale, searchForRent, searchProperties).",
      "editor": "select",
      "enum": [
        "Apartment",
        "Builder Floor",
        "Independent House",
        "Villa",
        "Plot",
        "Penthouse",
        "Studio Apartment",
        "Farm House",
        "Serviced Apartment",
        "Commercial Office",
        "Office in IT Park/SEZ",
        "Commercial Shop",
        "Commercial Showroom"
      ],
      "enumTitles": [
        "Apartment / flat",
        "Builder floor",
        "Independent house",
        "Villa",
        "Plot / land",
        "Penthouse",
        "Studio apartment",
        "Farm house",
        "Serviced apartment",
        "Commercial office",
        "Office in IT park / SEZ",
        "Commercial shop",
        "Commercial showroom"
      ],
      "prefill": "Apartment",
      "title": "Property type",
      "type": "string"
    },
    "sortBy": {
      "default": "Relevance",
      "description": "Order of search results (mode=searchForSale, searchForRent, searchProperties).",
      "editor": "select",
      "enum": [
        "Relevance",
        "Price - Low to High",
        "Price - High to Low",
        "Most Recent",
        "Rate/sqft - Low to High",
        "Rate/sqft - High to Low"
      ],
      "enumTitles": [
        "Relevance",
        "Price: low to high",
        "Price: high to low",
        "Most recent",
        "Rate per sq.ft: low to high",
        "Rate per sq.ft: high to low"
      ],
      "prefill": "Relevance",
      "title": "Sort by",
      "type": "string"
    },
    "startUrls": {
      "default": [],
      "description": "MagicBricks search-result or property-detail links (mode=bySearchUrl or byPropertyUrl).",
      "editor": "requestListSources",
      "items": {
        "properties": {
          "url": {
            "description": "MagicBricks search-result or property-detail URL.",
            "title": "URL",
            "type": "string"
          }
        },
        "type": "object"
      },
      "prefill": [],
      "title": "Search or property URLs",
      "type": "array"
    },
    "tenantType": {
      "default": "Any",
      "description": "Who the landlord accepts (mode=searchForRent and rent searches in searchProperties). MagicBricks exposes Bachelors and Family server-side.",
      "editor": "select",
      "enum": [
        "Any",
        "Bachelors",
        "Family"
      ],
      "enumTitles": [
        "Any",
        "Bachelors",
        "Family"
      ],
      "prefill": "Any",
      "title": "Tenant preference",
      "type": "string"
    }

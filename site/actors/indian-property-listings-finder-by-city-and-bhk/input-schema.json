      "prefill": false,
      "title": "Fetch detail pages",
      "type": "boolean"
    },
    "localities": {
      "description": "Optional locality or neighbourhood names inside the city (mode=searchForSale, searchForRent, searchProperties). One search is run per locality.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "title": "Localities",
      "type": "array"
    },
    "maxItems": {
      "default": 50,
      "description": "Hard cap on the number of property records returned.",
      "maximum": 10000,
      "minimum": 1,
      "prefill": 3,
      "title": "Max listings",
      "type": "integer"
    },
    "mode": {
      "default": "searchForSale",
      "description": "What to collect. Search by city and filters, paste MagicBricks search-result URLs, or paste property-detail URLs.",
      "editor": "select",
      "enum": [
        "searchForSale",
        "searchForRent",
        "searchProperties",
        "bySearchUrl",
        "byPropertyUrl"
      ],
      "enumTitles": [
        "Search properties for sale",
        "Search properties for rent",
        "Search both sale and rent",
        "Scrape MagicBricks search-result URLs",
        "Scrape MagicBricks property URLs"
      ],
      "prefill": "searchForSale",
      "title": "Mode",
      "type": "string"
    },
    "possessionStatus": {
      "default": "Any",
      "description": "Ready-to-move or under-construction filter (mode=searchForSale, searchProperties).",
      "editor": "select",
      "enum": [
        "Any",
        "Ready to Move",
        "Under Construction"
      ],
      "enumTitles": [
        "Any",
        "Ready to move",
        "Under construction"
      ],
      "prefill": "Any",
      "title": "Possession",
      "type": "string"
    },
    "postedSince": {
      "default": "Any",
      "description": "Only listings posted in the last 24 hours (mode=searchForSale, searchForRent, searchProperties). MagicBricks does not expose wider server-side posting windows.",
      "editor": "select",
      "enum": [
        "Any",
        "1"
      ],
      "enumTitles": [
        "Any time",
        "Last 24 hours"
      ],
      "prefill": "Any",
      "title": "Posted within",
      "type": "string"
    },

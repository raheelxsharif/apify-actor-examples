    },
    "maxItems": {
      "default": 50,
      "description": "Hard cap on emitted records.",
      "maximum": 1000,
      "minimum": 1,
      "prefill": 3,
      "title": "Max items",
      "type": "integer"
    },
    "meetupCategory": {
      "description": "Browse or filter Meetup by a live topic category. Use `all` with a query for no category filter.",
      "editor": "select",
      "enum": [
        "all",
        "social-activities",
        "hobbies-passions",
        "sports-fitness",
        "travel-outdoor",
        "career-business",
        "technology",
        "community-environment",
        "identity-language",
        "games",
        "dancing",
        "support-coaching",
        "music",
        "health-wellbeing",
        "art-culture",
        "science-education",
        "pets-animals",
        "religion-spirituality",
        "writing",
        "parents-family",
        "movements-politics"
      ],
      "enumTitles": [
        "All categories",
        "Social Activities",
        "Hobbies & Passions",
        "Sports & Fitness",
        "Travel & Outdoor",
        "Career & Business",
        "Technology",
        "Community & Environment",
        "Identity & Language",
        "Games",
        "Dancing",
        "Support & Coaching",
        "Music",
        "Health & Wellbeing",
        "Art & Culture",
        "Science & Education",
        "Pets & Animals",
        "Religion & Spirituality",
        "Writing",
        "Parents & Family",
        "Movements & Politics"
      ],
      "title": "Meetup category",
      "type": "string"
    },
    "minAttendees": {
      "description": "Drop events below this RSVP/guest count. Meetup filters server-side; Lu.ma filters client-side.",
      "maximum": 100000,
      "minimum": 0,
      "title": "Minimum attendees",
      "type": "integer"
    },
    "mode": {
      "default": "searchEvents",
      "description": "What to scrape: search, specific event/group/calendar URLs, group/calendar event lists, nearby discovery, or auto-routed URLs.",
      "editor": "select",
      "enum": [
        "searchEvents",
        "byEvent",
        "byGroup",
        "groupEvents",
        "byCalendar",
        "discoverNearby",
        "discoverTrending",
        "byUrl"
      ],
      "enumTitles": [
        "Search events",
        "By event URL/slug/ID",
        "By group or calendar profile",
        "Group/calendar event list",
        "By calendar (profile + events)",
        "Discover nearby",
        "Discover trending",
        "By URL (auto-routes)"
      ],
      "prefill": "searchEvents",
      "title": "Mode",
      "type": "string"
    },
    "onlyNewSinceLastRun": {
      "default": false,
      "description": "Remember emitted IDs for this exact input and skip them on later runs. The first run emits everything.",
      "prefill": false,
      "title": "Only new since last run",
      "type": "boolean"
    },
    "platform": {
      "default": "meetup",
      "description": "Which platform to query. All modes are HTTP-only and need no login.",
      "editor": "select",
      "enum": [
        "meetup",
        "luma"
      ],
      "enumTitles": [
        "Meetup.com",
        "Lu.ma"
      ],
      "prefill": "meetup",
      "title": "Platform",
      "type": "string"
    },
    "query": {
      "description": "Free-text keyword. Required for Meetup search. Lu.ma keyword search caps at 50 results per run.",
      "editor": "textfield",
      "prefill": "tech",
      "title": "Search query",
      "type": "string"
    },
    "radiusKm": {
      "description": "Meetup search radius around the resolved location.",
      "maximum": 500,
      "minimum": 1,
      "title": "Radius (km)",
      "type": "integer"
    },
    "slugs": {
      "default": [],
      "description": "Meetup group urlnames or Lu.ma event/calendar slugs. For Meetup events, pair index-aligned with `eventIds`.",
      "editor": "stringList",
      "title": "Slugs",
      "type": "array"
    },
    "sortBy": {
      "default": "relevance",
      "description": "Meetup sorts server-side. Lu.ma sorts client-side by start date; relevance keeps source order.",
      "editor": "select",
      "enum": [
        "relevance",
        "dateAsc",
        "dateDesc"
      ],
      "enumTitles": [
        "Relevance",
        "Date: soonest first",
        "Date: latest first"
      ],
      "prefill": "relevance",
      "title": "Sort order",
      "type": "string"
    },
    "urls": {
      "default": [],
      "description": "One or more Meetup or Lu.ma URLs. `mode=byUrl` auto-routes each one; `byEvent`, `byGroup`, and calendar modes also accept URLs.",
      "editor": "stringList",
      "title": "Event / group / calendar URLs",
      "type": "array"
    }
  },
  "required": [
    "platform",
    "mode"
  ],
  "schemaVersion": 1,
  "title": "Meetup + Lu.ma Events Scraper Input",
  "type": "object"
}

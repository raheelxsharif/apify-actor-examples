{
  "description": "Find events on Meetup and Lu.ma by keyword, city, group, calendar, URL, or event ID. No login or API key required.",
  "properties": {
    "country": {
      "description": "Optional ISO country code used when resolving a Meetup location.",
      "editor": "select",
      "enum": [
        "us",
        "ca",
        "gb",
        "de",
        "fr",
        "es",
        "it",
        "nl",
        "se",
        "ch",
        "ie",
        "au",
        "nz",
        "in",
        "sg",
        "jp",
        "br",
        "mx",
        "ar",
        "be",
        "at",
        "pl",
        "pt",
        "dk",
        "fi",
        "no",
        "cz",
        "il",
        "ae",
        "za"
      ],
      "enumTitles": [
        "United States",
        "Canada",
        "United Kingdom",
        "Germany",
        "France",
        "Spain",
        "Italy",
        "Netherlands",
        "Sweden",
        "Switzerland",
        "Ireland",
        "Australia",
        "New Zealand",
        "India",
        "Singapore",
        "Japan",
        "Brazil",
        "Mexico",
        "Argentina",
        "Belgium",
        "Austria",
        "Poland",
        "Portugal",
        "Denmark",
        "Finland",
        "Norway",
        "Czechia",
        "Israel",
        "United Arab Emirates",
        "South Africa"
      ],
      "title": "Country (Meetup)",
      "type": "string"
    },
    "dateFrom": {
      "description": "Earliest event date (inclusive). Accepts `YYYY-MM-DD` or an ISO date-time.",
      "editor": "textfield",
      "title": "Start date",
      "type": "string"
    },
    "dateTo": {
      "description": "Latest event date (inclusive). Accepts `YYYY-MM-DD` or an ISO date-time.",
      "editor": "textfield",
      "title": "End date",
      "type": "string"
    },
    "enrichDetails": {
      "default": false,
      "description": "Fetch each Lu.ma event's detail endpoint for description, ticket tiers, and featured guests. Off by default for speed.",
      "prefill": false,
      "title": "Enrich Lu.ma details",
      "type": "boolean"
    },
    "eventIds": {
      "default": [],
      "description": "Numeric Meetup event IDs or Lu.ma `evt-...` ids. Meetup numeric IDs can be used alone or index-aligned with `slugs` (group urlnames).",
      "editor": "stringList",
      "title": "Event IDs",
      "type": "array"
    },
    "eventPeriod": {
      "default": "upcoming",
      "description": "Upcoming, past, or both. Past is reliable on Meetup groups and Lu.ma calendars; Lu.ma city/category feeds are upcoming-only.",
      "editor": "select",
      "enum": [
        "upcoming",
        "past",
        "all"
      ],
      "enumTitles": [
        "Upcoming",
        "Past",
        "Upcoming + past"
      ],
      "prefill": "upcoming",
      "title": "Event period",
      "type": "string"
    },
    "eventType": {
      "default": "any",
      "description": "Meetup server-side event format filter. Lu.ma location types are not reliable, so Lu.ma ignores this field.",
      "editor": "select",
      "enum": [
        "any",
        "physical",
        "online",
        "hybrid"
      ],
      "enumTitles": [
        "Any",
        "In person",
        "Online",
        "Hybrid"
      ],
      "prefill": "any",
      "title": "Event type (Meetup)",
      "type": "string"
    },
    "freeOnly": {
      "default": false,
      "description": "Drop events that are known to charge. Events with an unknown price are kept.",
      "prefill": false,
      "title": "Free events only",
      "type": "boolean"
    },
    "includeAttendees": {
      "default": false,
      "description": "Add public RSVP names/photos to Meetup events (one extra request per event, capped at 250).",
      "prefill": false,
      "title": "Include Meetup attendees",
      "type": "boolean"
    },
    "includeMembers": {
      "default": false,
      "description": "Add a public member sample to Meetup group records (one extra request per group).",
      "prefill": false,
      "title": "Include Meetup group members",
      "type": "boolean"
    },
    "lat": {
      "description": "Explicit latitude. Bypasses location geocoding and anchors Lu.ma category feeds.",
      "maximum": 90,
      "minimum": -90,
      "title": "Latitude",
      "type": "number"
    },
    "lng": {
      "description": "Explicit longitude. Bypasses location geocoding and anchors Lu.ma category feeds.",
      "maximum": 180,
      "minimum": -180,
      "title": "Longitude",
      "type": "number"
    },
    "location": {
      "description": "City, state, or country. Meetup resolves it server-side; Lu.ma resolves the featured city. Examples: `san francisco`, `New York, NY`, `London, UK`.",
      "editor": "textfield",
      "prefill": "san francisco",
      "title": "Location",
      "type": "string"
    },
    "lumaCategory": {
      "description": "Lu.ma category feed. Needs a city or `lat`/`lng` to anchor the feed.",
      "editor": "select",
      "enum": [
        "family",
        "books",
        "games",
        "tech",
        "food",
        "ai",
        "running",
        "arts",
        "climate",
        "fitness",
        "wellness",
        "crypto"
      ],
      "enumTitles": [
        "Family",
        "Books",
        "Games",
        "Tech",
        "Food & Drink",
        "AI",
        "Running",
        "Arts & Culture",
        "Climate",
        "Fitness",
        "Wellness",
        "Crypto"
      ],
      "title": "Lu.ma category",
      "type": "string"
    },

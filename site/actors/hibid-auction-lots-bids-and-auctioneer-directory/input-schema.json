{
  "description": "Search or browse live and timed auction lots, auctions, and auctioneers on HiBid.com.",
  "properties": {
    "auctionIds": {
      "default": [],
      "description": "Scope lot search to one or more auctions (mode=lots: all IDs searched in turn), or look up full auction details (mode=auctionDetails: all IDs used). Find IDs in HiBid auction URLs, e.g. `hibid.com/auction/755763/...` → `755763`.",
      "editor": "stringList",
      "prefill": [],
      "title": "Auction IDs (mode=lots/auctionDetails)",
      "type": "array"
    },
    "auctionType": {
      "default": "ALL",
      "description": "Filter by bidding format (mode=lots/auctions).",
      "editor": "select",
      "enum": [
        "ALL",
        "ONLINE",
        "BIDDABLE",
        "ABSENTEE",
        "WEBCAST",
        "LISTING"
      ],
      "enumTitles": [
        "All types",
        "Online / timed only",
        "Biddable (live internet bidding)",
        "Absentee bidding",
        "Webcast (live simulcast)",
        "Listing only (no online bidding)"
      ],
      "prefill": "ALL",
      "title": "Auction type",
      "type": "string"
    },
    "auctioneerName": {
      "description": "Filter auctioneers/auction houses by name (mode=auctioneers).",
      "editor": "textfield",
      "title": "Auctioneer name",
      "type": "string"
    },
    "category": {
      "default": "",
      "description": "Filter by top-level HiBid category (mode=lots/auctions).",
      "editor": "select",
      "enum": [
        "",
        "700001",
        "40089",
        "700006",
        "40118",
        "700009",
        "700008",
        "40196",
        "40111",
        "40237",
        "700004",
        "40252",
        "700003",
        "40060",
        "700002",
        "700007",
        "40391",
        "40359"
      ],
      "enumTitles": [
        "Any category",
        "Antiques & Collectibles",
        "Art",
        "Cars & Vehicles",
        "Coins & Currency",
        "Business & Industrial",
        "Construction & Farm",
        "Computers & Electronics",
        "Fashion",
        "Furniture",
        "Home Goods & Decor",
        "Jewelry, Watches & Gemstones",
        "Lawn & Garden",
        "Real Estate",
        "Sporting Goods",
        "Boats & Aviation",
        "Kid & Baby Essentials",
        "Toys"
      ],
      "prefill": "",
      "title": "Category",
      "type": "string"
    },
    "includeBidHistory": {
      "default": false,
      "description": "Add the public bid ledger (`bidHistory`: bid amount + count per level) to every lot in mode=lots. Costs one extra request per lot; mode=lotDetails and mode=bidHistory always include it.",
      "prefill": false,
      "title": "Include public bid history",
      "type": "boolean"
    },
    "includeEnded": {
      "default": false,
      "description": "Include closed/ended auctions and lots instead of only currently open ones (mode=lots/auctions). The archive search is capped by HiBid at 1,000 rows; narrow it with a category, state, or keyword to page further.",
      "prefill": false,
      "title": "Include ended (archived)",
      "type": "boolean"
    },
    "lotIds": {
      "default": [],
      "description": "Look up specific lots by ID (mode=lotDetails) or fetch their public bid history (mode=bidHistory). Find IDs in HiBid lot URLs, e.g. `hibid.com/lot/307654532/...` → `307654532`.",
      "editor": "stringList",
      "prefill": [],
      "title": "Lot IDs (mode=lotDetails/bidHistory)",
      "type": "array"
    },
    "maxItems": {
      "default": 50,
      "description": "Hard cap on emitted records.",
      "maximum": 2000,
      "minimum": 1,
      "prefill": 50,
      "title": "Max items",
      "type": "integer"
    },
    "milesRadius": {
      "default": 50,
      "description": "Only include auctions/lots within this many miles of `zipCode`. Ignored if `zipCode` is empty.",
      "maximum": 3000,
      "minimum": 1,
      "prefill": 50,
      "title": "Distance radius (miles)",
      "type": "integer"
    },
    "mode": {
      "default": "lots",
      "description": "What to fetch.",
      "editor": "select",
      "enum": [
        "lots",
        "auctions",
        "lotDetails",
        "auctionDetails",
        "auctioneers",
        "bidHistory"
      ],
      "enumTitles": [
        "Search / browse lots (individual items)",
        "Search / browse auctions (events)",
        "Lookup specific lots by ID (with bid history)",
        "Lookup specific auctions by ID",
        "Search auctioneers / auction houses",
        "Public bid history for specific lots"
      ],
      "prefill": "lots",
      "title": "Mode",
      "type": "string"
    },
    "proxyConfiguration": {
      "default": {
        "useApifyProxy": true
      },
      "description": "HiBid's browse/search API works without any proxy from most datacenter IPs. Leave AUTO on for resilience; no paid proxy group is required.",
      "editor": "proxy",
      "prefill": {
        "useApifyProxy": true
      },
      "title": "Proxy configuration",
      "type": "object"
    },
    "searchText": {
      "default": "tractor",
      "description": "Free-text keyword search (mode=lots/auctions). Searches titles and descriptions.",
      "editor": "textfield",
      "prefill": "tractor",
      "title": "Search keyword",
      "type": "string"
    },
    "shippingOfferedOnly": {
      "default": false,
      "description": "Only include lots/auctions where the auctioneer offers shipping (mode=lots/auctions).",
      "prefill": false,
      "title": "Shipping offered only",
      "type": "boolean"
    },
    "sortOrder": {
      "default": "LOT_NUMBER",
      "description": "Sort order for lot results (mode=lots only).",
      "editor": "select",
      "enum": [
        "LOT_NUMBER",
        "TIME_LEFT",
        "NEWLY_ADDED",
        "HOT_RANK",
        "BID_COUNT_HIGH_TO_LOW",
        "BID_COUNT_LOW_TO_HIGH",
        "MAX_BID_HIGH_TO_LOW",
        "MAX_BID_LOW_TO_HIGH",
        "BID_AMOUNT_HIGH_TO_LOW",
        "BID_AMOUNT_LOW_TO_HIGH",
        "LAST_BID",
        "PENDING_BIDS",
        "SALE_ORDER",
        "VIEW_COUNT_HIGH_TO_LOW",
        "VIEW_COUNT_LOW_TO_HIGH",
        "WATCH_COUNT_HIGH_TO_LOW",
        "WATCH_COUNT_LOW_TO_HIGH",
        "DISTANCE_NEAREST",
        "NO_ORDER"
      ],
      "enumTitles": [
        "Lot number (default)",
        "Ending soonest",
        "Newly added",
        "Hot rank",
        "Most bids",
        "Fewest bids",
        "Highest current bid",
        "Lowest current bid",
        "Highest bid amount",
        "Lowest bid amount",
        "Most recent bid",
        "Pending bids first",
        "Sale order",
        "Most viewed",
        "Least viewed",
        "Most watched",
        "Least watched",
        "Nearest (requires zip)",
        "No particular order"
      ],
      "prefill": "LOT_NUMBER",
      "title": "Sort order",
      "type": "string"
    },

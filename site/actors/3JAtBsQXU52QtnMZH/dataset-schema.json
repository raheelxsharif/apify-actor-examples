            "format": "text",
            "label": "Careers"
          },
          "companyName": {
            "format": "text",
            "label": "Company"
          },
          "hiringSignal": {
            "format": "object",
            "label": "Hiring"
          }
        }
      },
      "title": "Hiring Signals",
      "transformation": {
        "fields": [
          "companyName",
          "ats",
          "careersUrl",
          "hiringSignal"
        ]
      }
    },
    "monitor": {
      "display": {
        "component": "table",

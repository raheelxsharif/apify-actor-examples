{
  "actorSpecification": 1,
  "description": "Graded company records with hiring, funding, news, executive-change, layoff and technology evidence, plus monitor diffs.",
  "title": "Company Intent Scorer: Hiring, Funding & News Signals Output",
  "views": {
    "funding": {
      "display": {
        "component": "table",
        "properties": {
          "companyName": {
            "format": "text",
            "label": "Company"
          },
          "fundingSignal": {
            "format": "object",
            "label": "Funding"
          }
        }
      },
      "title": "Funding Signals",
      "transformation": {
        "fields": [
          "companyName",
          "fundingSignal"
        ]
      }
    },
    "hiring": {
      "display": {
        "component": "table",
        "properties": {
          "ats": {
            "format": "text",
            "label": "ATS"
          },

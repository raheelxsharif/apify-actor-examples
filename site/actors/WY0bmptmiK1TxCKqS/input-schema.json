      "enum": [
        "searchCompanies",
        "browseDirectory",
        "browseCategoryOrRegion",
        "companyDetails"
      ],
      "enumTitles": [
        "Search companies by keyword",
        "Browse a country/type directory",
        "Browse category, region, activity, or sector URLs",
        "Fetch details for company URLs or IDs"
      ],
      "prefill": "searchCompanies",
      "title": "Mode",
      "type": "string"
    },
    "query": {
      "default": "pumps",
      "description": "Company name, product, or service keyword (mode=searchCompanies).",
      "editor": "textfield",
      "prefill": "pumps",
      "title": "Search query",
      "type": "string"
    },
    "searchType": {
      "default": "all",
      "description": "Match all text, company names only, or products/services only (mode=searchCompanies).",
      "editor": "select",
      "enum": [
        "all",
        "companyName",
        "products"
      ],
      "enumTitles": [
        "All text",
        "Company names",
        "Products and services"
      ],
      "prefill": "all",
      "title": "Search type",
      "type": "string"
    },
    "sector": {

{
  "description": "Search or browse the Kompass global B2B directory, or fetch company profiles.",
  "properties": {
    "archivePages": {
      "default": 8,
      "description": "Wayback CDX index pages to scan per market when live pages are blocked (mode=searchCompanies). Each page holds about 1,700 archived company URLs.",

      "prefill": "chef",
      "title": "Keywords",
      "type": "string"
    },
    "location": {
      "description": "City, region, or landmark to search near (e.g. `New York, NY`, `Miami Beach`). (mode=search)",
      "editor": "textfield",
      "title": "Location",
      "type": "string"
    },
    "maxItems": {
      "default": 24,
      "description": "Hard cap on emitted records (jobs plus employer profiles).",
      "maximum": 5000,
      "minimum": 1,
      "prefill": 24,
      "title": "Max items",

        "Knowledge Management",
        "Operations",
        "Research",
        "Strategy",
        "Supply Chain",
        "Travel and Hospitality",
        "All others"
      ],
      "prefill": "",
      "title": "Job category",
      "type": "string"
    },
    "excludeKeywords": {
      "default": [],
      "description": "Drop jobs whose title or company contains any of these words, e.g. senior, manager, commission.",
      "editor": "stringList",
      "prefill": [],
      "title": "Exclude keywords",
      "type": "array"
    },
    "includeDetails": {
      "default": true,
      "description": "Open each job page for the full description, expiry date, company website and eligible countries. Disable for a faster metadata-only run.",
      "prefill": true,
      "title": "Fetch full descriptions",
      "type": "boolean"
    },
    "jobType": {
      "default": "",
      "description": "Keep one employment type. Legacy labels such as Full-time, full_time and Full Time are accepted.",
      "editor": "select",
      "enumSuggestedValues": [
        "",
        "full-time",
        "part-time",
        "contract",
        "freelance",
        "internship",
        "temporary",
        "apprenticeship",
        "casual",
        "other",
        "per-diem",
        "project-based",
        "volunteer"
      ],
      "enumTitles": [
        "Any type",
        "Full-time",
        "Part-time",
        "Contract",
        "Freelance",
        "Internship",
        "Temporary",
        "Apprenticeship",
        "Casual",
        "Other",
        "Per diem",
        "Project-based",
        "Volunteer"
      ],
      "prefill": "",
      "title": "Employment type",
      "type": "string"
    },
    "language": {
      "default": "",
      "description": "Keep listings written in one language. Use an ISO 639-1 code such as en, de, fr, es, pt or ja.",
      "editor": "select",
      "enumSuggestedValues": [
        "",
        "en",
        "de",
        "fr",
        "es",
        "pt",
        "it",
        "nl",
        "pl",
        "ja",
        "ko",
        "zh-cn",
        "uk",
        "sv",
        "ru",
        "tr"
      ],
      "enumTitles": [
        "Any language",
        "English",
        "German",
        "French",
        "Spanish",
        "Portuguese",
        "Italian",
        "Dutch",
        "Polish",
        "Japanese",
        "Korean",
        "Chinese",
        "Ukrainian",
        "Swedish",
        "Russian",
        "Turkish"
      ],
      "prefill": "",
      "title": "Listing language",
      "type": "string"
    },
    "location": {
      "default": "",
      "description": "Keep jobs whose candidate location includes this country or region, e.g. USA, Europe, Worldwide, Germany. Any Remotive location facet is accepted.",
      "editor": "select",
      "enumSuggestedValues": [
        "",
        "USA",
        "Europe",
        "Worldwide",
        "Canada",
        "UK",
        "Germany",
        "France",
        "India",
        "Brazil",
        "Latin America (LATAM)",
        "United Arab Emirates",
        "Australia",
        "Japan",
        "South Africa",
        "Poland",
        "Spain",
        "Netherlands",
        "Portugal",
        "Mexico",
        "Argentina"
      ],
      "enumTitles": [
        "Any location",
        "USA",
        "Europe",
        "Worldwide",
        "Canada",
        "UK",
        "Germany",
        "France",
        "India",
        "Brazil",
        "Latin America (LATAM)",
        "United Arab Emirates",
        "Australia",
        "Japan",
        "South Africa",
        "Poland",
        "Spain",
        "Netherlands",
        "Portugal",
        "Mexico",
        "Argentina"
      ],
      "prefill": "",
      "title": "Candidate location",
      "type": "string"
    },
    "maxItems": {
      "default": 100,
      "description": "Maximum number of job records to return.",
      "maximum": 10000,
      "minimum": 1,
      "prefill": 3,
      "title": "Max items",
      "type": "integer"
    },
    "mode": {
      "default": "browse",
      "description": "Browse the catalog or search with a keyword. Both modes accept all filters and paginate the public result pages.",
      "editor": "select",
      "enumSuggestedValues": [
        "browse",
        "search"
      ],
      "enumTitles": [
        "Browse all jobs",
        "Search with a keyword"
      ],
      "prefill": "browse",
      "title": "Mode",
      "type": "string"
    },
    "postedWithinDays": {
      "default": 0,
      "description": "Keep jobs published within this many days. 0 disables the filter.",
      "maximum": 90,
      "minimum": 0,
      "prefill": 0,
      "title": "Posted within (days)",
      "type": "integer"
    },
    "query": {
      "default": "",
      "description": "Keyword matched by Remotive against job titles and descriptions. Leave blank to browse. Old inputs that use 'search' or 'keyword' still work.",
      "editor": "textfield",
      "prefill": "",
      "title": "Search keyword",
      "type": "string"
    },
    "salaryDisclosedOnly": {
      "default": false,
      "description": "Keep only listings that show a salary range.",
      "prefill": false,
      "title": "Only jobs with a published salary",
      "type": "boolean"
    },
    "seniority": {
      "default": "",
      "description": "Keep one career level. Legacy labels such as Midweight, Director and Any are mapped automatically.",
      "editor": "select",
      "enumSuggestedValues": [
        "",
        "entry-level",
        "junior",
        "mid-level",
        "senior",
        "lead",
        "executive",
        "intern",
        "student"
      ],
      "enumTitles": [
        "Any level",
        "Entry-level",
        "Junior",
        "Mid-level",
        "Senior",
        "Lead",
        "Executive",
        "Intern",
        "Student"
      ],
      "prefill": "",
      "title": "Seniority level",
      "type": "string"
    },
    "skillMatch": {
      "default": "any",
      "description": "Return jobs that match any listed skill, or only jobs that carry every listed skill.",
      "editor": "select",
      "enumSuggestedValues": [
        "any",
        "all"
      ],
      "enumTitles": [
        "Any listed skill",
        "All listed skills"
      ],
      "prefill": "any",
      "title": "Skill matching",
      "type": "string"
    },
    "skills": {
      "default": [],
      "description": "Keep jobs tagged with these skills, e.g. python, react, sql. Combine with 'Skill matching' to require any or all of them.",
      "editor": "stringList",
      "prefill": [],
      "title": "Skills",
      "type": "array"
    }
  },
  "schemaVersion": 1,
  "title": "Remotive Remote Job Listings Input",
  "type": "object"
}

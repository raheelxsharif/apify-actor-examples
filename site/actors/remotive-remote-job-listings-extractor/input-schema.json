{
  "description": "Browse or search Remotive's public remote job catalog with filters and result-page pagination.",
  "properties": {
    "category": {
      "default": "",
      "description": "Keep jobs from one Remotive category. Legacy slugs such as software-dev are mapped automatically.",
      "editor": "select",
      "enumSuggestedValues": [
        "",
        "Software Development",
        "Customer Service",
        "Design",
        "Marketing",
        "Sales",
        "Product Management",
        "Project Management",

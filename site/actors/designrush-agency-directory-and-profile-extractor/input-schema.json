{
  "description": "Browse DesignRush agency rankings with service-category, location, budget, industry and sort filters, or read specific agency profiles.",
  "properties": {
    "agencyUrls": {
      "default": [],
      "description": "DesignRush agency profile URLs or slugs, e.g. https://www.designrush.com/agency/profile/smartsites.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": [],
      "title": "Agency profile URLs (mode=byUrl)",
      "type": "array"
    },
    "budget": {
      "default": "any",
      "description": "Only show agencies whose minimum project budget falls in this range.",

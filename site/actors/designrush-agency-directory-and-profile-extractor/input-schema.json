    "location": {
      "default": "",
      "description": "Optional DesignRush location slug: us, uk, a US state (new-york, california), or a state/city pair (new-york/new-york-city). Leave empty for agencies worldwide. You can also paste a DesignRush directory URL.",
      "editor": "textfield",
      "prefill": "",
      "title": "Location path",
      "type": "string"
    },
    "maxItems": {
      "default": 50,
      "description": "Hard cap on the number of agency records returned.",
      "maximum": 5000,
      "minimum": 1,
      "prefill": 3,
      "title": "Max items",
      "type": "integer"
    },
    "maxPages": {
      "default": 20,
      "description": "Maximum number of directory pages to read in this run (1-432). The actor also stops when it reaches Max items or the last page.",
      "maximum": 432,
      "minimum": 1,
      "prefill": 1,
      "title": "Max pages",
      "type": "integer"
    },
    "mode": {
      "default": "byCategory",
      "description": "Browse the agency directory or read specific agency profiles.",
      "editor": "select",
      "enum": [
        "byCategory",
        "byUrl"
      ],
      "enumTitles": [
        "Browse the agency directory",
        "Read specific agency profiles"
      ],
      "prefill": "byCategory",
      "title": "Mode",
      "type": "string"
    },
    "sortBy": {
      "default": "sponsored",
      "description": "How DesignRush should order the directory results.",
      "editor": "select",
      "enum": [
        "sponsored",
        "organic",
        "topRated",
        "mostReviewed",
        "hourlyHighToLow",
        "hourlyLowToHigh"
      ],
      "enumTitles": [
        "Sponsored / DesignRush order",
        "Organic ranking",
        "Top rated",
        "Most reviewed",
        "Average hourly rate: high to low",
        "Average hourly rate: low to high"
      ],
      "prefill": "sponsored",
      "title": "Sort order",
      "type": "string"
    },
    "startPage": {
      "default": 1,
      "description": "Directory page to start from (1-432). Useful for splitting large categories across runs.",
      "maximum": 432,
      "minimum": 1,
      "prefill": 1,
      "title": "Start page",
      "type": "integer"
    },
    "startUrls": {
      "default": [],
      "description": "Alternative profile URL input for saved tasks. Accepts Apify request-list objects or plain strings.",
      "editor": "requestListSources",
      "items": {
        "properties": {
          "url": {
            "description": "DesignRush agency profile URL.",
            "title": "Profile URL",
            "type": "string"
          }
        },
        "type": "object"
      },
      "prefill": [],
      "title": "Start URLs (mode=byUrl)",
      "type": "array"
    }
  },
  "required": [
    "mode"
  ],
  "schemaVersion": 1,
  "title": "DesignRush Agency Directory & Profile Input",
  "type": "object"
}

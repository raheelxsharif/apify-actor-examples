      "title": "State or province (mode=byState)",
      "type": "string"
    },
    "vehicleMake": {
      "description": "Structured make/brand filter (e.g. `Ford`, `Caterpillar`, `Peterbilt`) — matches GovDeals' own vehicle-search field, more precise than a keyword search.",
      "editor": "textfield",
      "title": "Vehicle/equipment make",
      "type": "string"
    },
    "vehicleModelYear": {
      "description": "Restrict to a specific model year.",
      "maximum": 2100,
      "minimum": 1900,
      "title": "Vehicle/equipment model year",
      "type": "integer"
    }
  },
  "required": [
    "mode"
  ],
  "schemaVersion": 1,
  "title": "GovDeals Scraper Input",
  "type": "object"
}

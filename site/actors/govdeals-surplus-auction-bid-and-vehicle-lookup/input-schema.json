{
  "description": "Search, browse, and filter GovDeals.com government & municipal surplus auction listings.",
  "properties": {
    "auctionStatus": {
      "default": "open",
      "description": "Only currently open (live) listings, or only closed/sold listings.",
      "editor": "select",
      "enum": [
        "open",
        "closed"
      ],
      "enumTitles": [
        "Open (live)",
        "Closed (sold)"
      ],
      "prefill": "open",
      "title": "Auction status filter",
      "type": "string"
    },
    "auctionType": {
      "default": "",
      "description": "Restrict results to a specific sale format.",
      "editor": "select",
      "enum": [
        "",
        "3",
        "4",
        "5",
        "9"
      ],
      "enumTitles": [
        "Any auction type",
        "Online Auction",
        "Buy Now",
        "Make Offer",
        "Sealed Bid"
      ],
      "prefill": "",
      "title": "Auction type filter",
      "type": "string"
    },
    "category": {
      "description": "Browse one of GovDeals' top-level categories.",
      "editor": "select",
      "enum": [
        "1",
        "2",
        "3",
        "4",
        "5",
        "6",
        "9",
        "10",
        "11",
        "12",
        "13",
        "14",
        "15",
        "16",
        "17"
      ],
      "enumTitles": [
        "Consumer Goods",
        "Consumer Electronics",
        "Energy Equipment",
        "Construction, Mining and Farming",
        "Industrial, Commercial Equipment",
        "Transportation",
        "BioPharma",
        "Scrap and Recycling",
        "Real Estate, Buildings, Structures",
        "Educational Equipment",
        "Public and Personal Safety",
        "Metalworking Equipment",
        "Food, Beverage and Packaging",
        "Electronics Manufacturing Equipment",
        "Computers and IT Equipment"
      ],
      "title": "Category (mode=byCategory)",
      "type": "string"
    },
    "country": {
      "default": "",
      "description": "Restrict results to one GovDeals country marketplace.",
      "editor": "select",
      "enum": [
        "",
        "USA",
        "CAN"
      ],
      "enumTitles": [
        "Any country",
        "United States",
        "Canada"
      ],
      "prefill": "",
      "title": "Country",
      "type": "string"
    },
    "endingWithinDays": {
      "description": "Only listings whose bidding closes within this many days. Applies to open listings; ignored for closed/sold.",
      "maximum": 365,
      "minimum": 1,
      "title": "Closing within (days)",
      "type": "integer"
    },
    "maxCurrentBid": {
      "description": "Drop listings with a current bid higher than this.",
      "maximum": 10000000,
      "minimum": 0,
      "title": "Max current bid (USD/CAD)",
      "type": "integer"
    },
    "maxItems": {
      "default": 50,
      "description": "Hard cap on emitted records.",
      "maximum": 2000,
      "minimum": 1,
      "prefill": 50,
      "title": "Max items",
      "type": "integer"
    },
    "minCurrentBid": {
      "description": "Drop listings with a current bid lower than this.",
      "maximum": 10000000,
      "minimum": 0,
      "title": "Min current bid (USD/CAD)",
      "type": "integer"
    },
    "mode": {
      "default": "search",
      "description": "What to fetch.",
      "editor": "select",
      "enum": [
        "search",
        "byCategory",
        "byState",
        "bySeller"
      ],
      "enumTitles": [
        "Search by keyword",
        "Browse by category",
        "Browse by state / province",
        "Browse by seller account"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "proxyConfiguration": {
      "default": {
        "useApifyProxy": false
      },
      "description": "Optional. GovDeals' edge (Akamai) may rate-limit sustained high-volume traffic; enabling the free AUTO proxy group adds resilience. Not required for normal use.",
      "editor": "proxy",
      "title": "Proxy configuration",
      "type": "object"
    },
    "searchRadiusMiles": {
      "description": "Radius around `searchZip`. Requires `searchZip`.",
      "maximum": 3000,
      "minimum": 1,
      "title": "Search radius (miles)",
      "type": "integer"
    },
    "searchText": {
      "default": "truck",
      "description": "Free-text keyword search (required for mode=search unless a vehicle make/model year is set). Can also narrow the category, state and seller modes.",
      "editor": "textfield",
      "prefill": "truck",
      "title": "Search keyword",
      "type": "string"
    },
    "searchZip": {
      "description": "Return listings near this US ZIP or Canadian postal code. Requires `searchRadiusMiles`.",
      "editor": "textfield",
      "title": "Near ZIP / postal code",
      "type": "string"
    },
    "sellerAccountIds": {
      "description": "One or more GovDeals seller account IDs, comma-separated (for example `26928,5725`). Required for mode=bySeller; can also be used as a filter in other modes.",
      "editor": "textfield",
      "title": "Seller account IDs (mode=bySeller)",
      "type": "string"
    },
    "sellerType": {
      "default": "",
      "description": "Government agencies, commercial sellers, or nonprofit sellers.",
      "editor": "select",
      "enum": [
        "",
        "government",
        "commercial",
        "nonprofit"
      ],
      "enumTitles": [
        "Any seller type",
        "Government",
        "Commercial",
        "Nonprofit"
      ],
      "prefill": "",
      "title": "Seller type",
      "type": "string"
    },
    "sortBy": {
      "default": "bestfit",
      "description": "How to order results.",
      "editor": "select",
      "enum": [
        "bestfit",
        "endingSoonest",
        "endingLatest",
        "priceLowToHigh",
        "priceHighToLow",
        "locationAZ"
      ],
      "enumTitles": [
        "Best match",
        "Ending soonest",
        "Ending latest",
        "Price: low to high",
        "Price: high to low",
        "Location A-Z"
      ],
      "prefill": "bestfit",
      "title": "Sort order",
      "type": "string"
    },
    "state": {
      "description": "Browse listings located in a specific US state, Canadian province/territory, or DC.",
      "editor": "select",
      "enum": [
        "AL",
        "AK",
        "AZ",
        "AR",
        "CA",
        "CO",
        "CT",
        "DE",
        "DC",
        "FL",

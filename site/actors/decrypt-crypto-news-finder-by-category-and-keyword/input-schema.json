    "dateRangeFrom": {
      "description": "Only articles published on or after this date (YYYY-MM-DD). The date range is applied by the source.",
      "editor": "datepicker",
      "title": "Published from",
      "type": "string"
    },
    "dateRangeTo": {
      "description": "Only articles published on or before this date (YYYY-MM-DD). The date range is applied by the source.",
      "editor": "datepicker",
      "title": "Published until",
      "type": "string"
    },
    "includeContent": {
      "default": true,
      "description": "Include full HTML and plain-text article bodies, TL;DR content and word count. Turn off for a lighter dataset.",
      "prefill": true,
      "title": "Include article body",
      "type": "boolean"
    },
    "locale": {
      "default": "",
      "description": "Article language. Leave empty to include every locale.",
      "editor": "select",
      "enum": [
        "",
        "en",
        "es",
        "fr",
        "ar",
        "zh-hans"
      ],
      "enumTitles": [
        "All languages",
        "English",
        "Spanish",
        "French",
        "Arabic",
        "Simplified Chinese"
      ],
      "prefill": "en",
      "title": "Language / locale",
      "type": "string"
    },
    "maxItems": {
      "default": 10,
      "description": "Maximum number of articles to return (1-10,000).",
      "maximum": 10000,
      "minimum": 1,
      "prefill": 1,
      "title": "Max articles",
      "type": "integer",
      "unit": "articles"
    },
    "mode": {
      "default": "search",
      "description": "What to fetch. Search matches titles, excerpts and article bodies. The latest mode returns the newest stories.",
      "editor": "select",
      "enum": [
        "search",
        "browseByCategory",
        "byId",
        "trending",
        "byTag",
        "byCoin",
        "byAuthor"
      ],
      "enumTitles": [
        "Search articles",
        "Browse a category",
        "Look up IDs or URLs",
        "Latest articles",
        "Browse a tag",
        "Browse a coin",
        "Browse an author"
      ],
      "prefill": "search",
      "title": "Mode",
      "type": "string"
    },
    "onlyNew": {
      "default": false,
      "description": "Skip article IDs returned by earlier runs of this actor. Useful for scheduled monitoring. State is kept automatically.",
      "prefill": false,
      "title": "Only new articles",
      "type": "boolean"
    },
    "proxyConfiguration": {
      "description": "Optional. Leave off for a direct connection; the actor does not require a proxy.",
      "editor": "proxy",
      "prefill": {
        "useApifyProxy": false
      },
      "title": "Proxy configuration",
      "type": "object"
    },
    "searchQuery": {
      "default": "",
      "description": "Keyword or phrase matched against article titles, excerpts and bodies (mode=search). E.g. bitcoin, ethereum, NFT.",
      "editor": "textfield",
      "prefill": "bitcoin",
      "title": "Search query",
      "type": "string"
    },
    "sortBy": {
      "default": "newest",
      "description": "Newest first, oldest first, or best match. Best match needs a search query; otherwise newest is used.",
      "editor": "select",
      "enum": [
        "newest",
        "oldest",
        "relevance"
      ],
      "enumTitles": [
        "Newest first",
        "Oldest first",
        "Best match"
      ],
      "prefill": "newest",
      "title": "Sort order",
      "type": "string"
    },
    "tagSlugs": {
      "default": [],
      "description": "Filter by Decrypt tag slugs, e.g. bitcoin, ethereum, regulation. Tag names are not accepted; use the slugs returned in each record.",
      "editor": "stringList",
      "prefill": [],
      "title": "Tag slugs",
      "type": "array"
    }
  },
  "required": [
    "mode"
  ],
  "schemaVersion": 1,
  "title": "Decrypt Crypto News Finder Input",

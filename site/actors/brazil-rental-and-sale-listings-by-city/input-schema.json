      "prefill": false,
      "title": "Exact city only",
      "type": "boolean"
    },
    "furnished": {
      "default": "any",
      "description": "Include only furnished listings, only unfurnished listings, or both.",
      "editor": "select",
      "enum": [
        "any",
        "yes",
        "no"
      ],
      "enumTitles": [
        "Any",
        "Furnished only",
        "Unfurnished only"
      ],
      "prefill": "any",
      "title": "Furnished",
      "type": "string"
    },
    "includeDetails": {
      "default": true,
      "description": "Load each listing's detail page for description, separate condo fee and IPTU, ZIP code, coordinates and full photo captions.",
      "prefill": false,
      "title": "Include detail fields",
      "type": "boolean"
    },
    "installations": {
      "description": "Building facility codes that must all be present, e.g. PISCINA, ACADEMIA (mode=rent or buy).",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "title": "Building facilities",
      "type": "array"
    },
    "listingUrls": {
      "description": "QuintoAndar listing links or numeric property IDs (mode=byUrls). Duplicates are ignored.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "title": "Listing URLs or IDs",
      "type": "array"
    },
    "maxItems": {
      "default": 500,
      "description": "Hard cap on the number of listings returned (1-5000). Values above 1000 use price-slice partitioning.",
      "maximum": 5000,
      "minimum": 1,
      "prefill": 3,
      "title": "Maximum listings",
      "type": "integer"
    },
    "mode": {
      "default": "rent",
      "description": "Search rentals, search properties for sale, or load specific listings by URL or ID.",
      "editor": "select",
      "enum": [
        "rent",
        "buy",
        "byUrls"
      ],
      "enumTitles": [
        "Rentals by location",
        "Properties for sale by location",
        "Specific listings by URL or ID"
      ],
      "prefill": "rent",
      "title": "Mode",
      "type": "string"
    },

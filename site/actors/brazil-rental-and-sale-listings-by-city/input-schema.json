      "enum": [
        "any",
        "yes"
      ],
      "enumTitles": [
        "Any",
        "Near subway only"
      ],
      "prefill": "any",
      "title": "Near subway",
      "type": "string"
    },
    "neighborhood": {
      "description": "Optional neighborhood inside the selected city, e.g. Pinheiros or Copacabana (mode=rent or buy).",
      "editor": "textfield",
      "title": "Neighborhood",
      "type": "string"
    },
    "parkingMax": {
      "description": "Most parking spaces a listing may have.",
      "maximum": 20,
      "minimum": 0,

      "enum": [
        "relevance",
        "newest",
        "cheapest",
        "expensive",
        "highestRent"
      ],
      "enumTitles": [
        "Relevance",
        "Newest",
        "Cheapest",
        "Most expensive",
        "Highest rental return"
      ],
      "prefill": "relevance",
      "title": "Sort by",
      "type": "string"
    },

      "enum": [
        "rent",
        "total"
      ],
      "enumTitles": [
        "Base rent",
        "Total monthly cost"
      ],
      "prefill": "rent",
      "title": "Price basis",
      "type": "string"
    },
    "priceMax": {
      "description": "Highest price to include, in Brazilian reais.",
      "maximum": 100000000,
      "minimum": 0,
      "title": "Maximum price (BRL)",
      "type": "integer"
    },
    "priceMin": {
      "description": "Lowest price to include, in Brazilian reais.",
      "maximum": 100000000,
      "minimum": 0,
      "title": "Minimum price (BRL)",
      "type": "integer"
    },
    "propertyType": {
      "default": "ANY",
      "description": "Restrict results to one property type (mode=rent or buy).",
      "editor": "select",
      "enum": [
        "ANY",
        "APARTMENT",
        "HOUSE",
        "HOUSE_CONDO",
        "STUDIO"
      ],
      "enumTitles": [
        "Any type",
        "Apartment",
        "House",
        "House in a condominium",
        "Studio or kitchenette"
      ],
      "prefill": "ANY",
      "title": "Property type",
      "type": "string"
    },
    "sortBy": {
      "default": "relevance",
      "description": "Order of the returned listings. Cheapest and most expensive use total monthly cost; highest rental return is the investor yield order.",

      },
      "post_url": {
        "description": "Direct URL to the Instagram post",
        "type": "string"
      },
      "pub_date": {
        "description": "ISO 8601 datetime when the post was published",
        "nullable": true,
        "type": "string"
      },
      "scraped_at": {
        "description": "ISO 8601 datetime when this record was scraped",
        "type": "string"
      },
      "shortcode": {
        "description": "Instagram shortcode identifying the post",
        "type": "string"
      },
      "status": {
        "description": "success for a scraped post or profile. Otherwise the reason there is none: post_age_restricted, post_is_private, post_not_found, blocked, error, invalid_url, cookies_unusable, profile_not_found, profile_is_private, profile_age_restricted or profile_restricted. The log explains each one",
        "type": "string"
      },
      "tagged_users": {
        "description": "Usernames tagged in the post",
        "type": "array"
      },
      "thumbnail_url": {
        "description": "Direct URL to the post's cover image",
        "nullable": true,
        "type": "string"
      },
      "username": {
        "description": "Instagram username of the post author",
        "type": "string"
      }

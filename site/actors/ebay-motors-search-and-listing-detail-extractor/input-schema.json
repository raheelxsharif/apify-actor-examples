{
  "description": "Search eBay Motors vehicles or parts, or enrich specific item URLs. Filters cover vehicle type, condition, price, model year, mileage, transmission, fuel type, buying format, seller and ZIP radius.",
  "properties": {
    "buyingFormat": {
      "description": "Restrict results to Buy It Now or auction listings. 'All formats' applies no filter.",
      "editor": "select",
      "enum": [
        "all",
        "buy-it-now",
        "auction"
      ],
      "enumTitles": [
        "All Formats",
        "Buy It Now",
        "Auction"
      ],
      "prefill": "all",
      "title": "Buying Format",
      "type": "string"
    },
    "condition": {
      "description": "Filter listings by condition.",
      "editor": "select",
      "enum": [
        "all",
        "new",
        "used",
        "certified-pre-owned",
        "for-parts-not-working"
      ],
      "enumTitles": [
        "All Conditions",
        "New",
        "Used",
        "Certified Pre-Owned",
        "For Parts / Not Working"
      ],
      "prefill": "all",
      "title": "Condition",
      "type": "string"
    },
    "distanceMiles": {
      "description": "Radius around the ZIP code. Requires a ZIP code.",
      "editor": "select",
      "enum": [
        "10",
        "25",
        "50",
        "100",
        "200",
        "500",
        "1000",
        "2000"
      ],
      "enumTitles": [
        "10 miles",
        "25 miles",
        "50 miles",
        "100 miles",
        "200 miles",
        "500 miles",
        "1,000 miles",
        "2,000 miles"
      ],
      "title": "Distance (miles)",
      "type": "string"
    },
    "fuelType": {
      "description": "Filter vehicles by fuel type.",
      "editor": "select",
      "enum": [
        "all",
        "gasoline",
        "diesel",
        "electric",
        "hybrid"
      ],
      "enumTitles": [
        "All Fuel Types",
        "Gasoline",
        "Diesel",
        "Electric",
        "Hybrid"
      ],
      "prefill": "all",
      "title": "Fuel Type",
      "type": "string"
    },
    "includeItemSpecifics": {
      "default": true,
      "description": "Attach the complete item-specifics table to listing-detail records (byListingUrls mode).",
      "prefill": true,
      "title": "Include Full Item Specifics",
      "type": "boolean"
    },
    "maxItems": {
      "description": "Maximum number of listings to return (1–10,000).",
      "editor": "number",
      "maximum": 10000,
      "minimum": 1,
      "prefill": 3,
      "title": "Max Items",
      "type": "integer"
    },
    "maxMileage": {
      "description": "Highest odometer reading to include, in miles (searchVehicles mode).",
      "editor": "number",
      "maximum": 2000000,
      "minimum": 0,
      "title": "Maximum Mileage",
      "type": "integer"
    },
    "maxPages": {
      "description": "Maximum search result pages to request. eBay caps every query at 200 pages.",
      "editor": "number",
      "maximum": 200,
      "minimum": 1,
      "prefill": 1,
      "title": "Max Pages",
      "type": "integer"
    },
    "maxPrice": {
      "description": "Maximum listing price in USD.",
      "editor": "number",
      "maximum": 10000000,
      "minimum": 0,
      "title": "Maximum Price ($)",
      "type": "integer"
    },
    "maxYear": {
      "description": "Newest model year to include (searchVehicles mode).",
      "editor": "number",
      "maximum": 2030,
      "minimum": 1900,
      "title": "Maximum Model Year",
      "type": "integer"
    },
    "minPrice": {
      "description": "Minimum listing price in USD.",
      "editor": "number",
      "maximum": 10000000,
      "minimum": 0,
      "title": "Minimum Price ($)",
      "type": "integer"
    },
    "minYear": {
      "description": "Oldest model year to include (searchVehicles mode).",
      "editor": "number",
      "maximum": 2030,
      "minimum": 1900,
      "title": "Minimum Model Year",
      "type": "integer"
    },
    "mode": {
      "default": "searchVehicles",
      "description": "Search vehicle listings, search parts & accessories, or enrich specific listing IDs/URLs.",
      "editor": "select",
      "enum": [
        "searchVehicles",
        "searchParts",
        "byListingUrls"
      ],
      "enumTitles": [
        "Search Vehicles",
        "Search Parts & Accessories",
        "By Listing URLs"
      ],
      "prefill": "searchVehicles",
      "title": "Scraping Mode",
      "type": "string"
    },
    "partCategory": {
      "description": "Parts category used in searchParts mode.",
      "editor": "select",
      "enum": [
        "car-truck-parts",
        "motorcycle-parts",
        "boat-parts",
        "atv-parts",
        "other"
      ],
      "enumTitles": [
        "Car & Truck Parts",
        "Motorcycle Parts",
        "Boat Parts",
        "ATV & UTV Parts",
        "Other Parts"
      ],
      "prefill": "car-truck-parts",
      "title": "Part Category",
      "type": "string"
    },
    "postalCode": {
      "description": "US ZIP code used with 'Distance' for local-inventory searches (optional).",
      "editor": "textfield",
      "title": "ZIP Code",
      "type": "string"
    },
    "searchQuery": {
      "description": "Keyword(s) to search for, e.g. 'toyota camry' or 'brake pads'. Leave empty in searchVehicles mode to browse eBay's trending vehicles for the selected category.",
      "editor": "textfield",
      "prefill": "honda civic",
      "title": "Search Query",
      "type": "string"
    },
    "sellerUsername": {
      "description": "Only return listings sold by this eBay seller or dealer (optional).",
      "editor": "textfield",
      "title": "Seller Username",
      "type": "string"
    },
    "sortBy": {
      "description": "How to order the search results.",
      "editor": "select",
      "enum": [
        "best-match",
        "price-asc",
        "price-desc",
        "distance-nearest",
        "newly-listed",
        "ending-soonest",
        "mileage-asc",
        "year-newest",
        "year-oldest"
      ],
      "enumTitles": [
        "Best Match",
        "Price: Lowest First",
        "Price: Highest First",
        "Distance: Nearest First",
        "Newly Listed",
        "Ending Soonest",
        "Mileage: Lowest First",
        "Year: Newest First",
        "Year: Oldest First"
      ],
      "prefill": "best-match",
      "title": "Sort By",
      "type": "string"
    },
    "startUrls": {
      "description": "eBay item URLs, bare item IDs or eBay search URLs to scrape in byListingUrls mode.",
      "editor": "stringList",
      "prefill": [],
      "title": "Start URLs / Item IDs",
      "type": "array"
    },
    "transmission": {
      "description": "Filter vehicles by transmission type.",
      "editor": "select",
      "enum": [
        "all",
        "automatic",
        "manual"
      ],
      "enumTitles": [
        "All Transmissions",
        "Automatic",
        "Manual"
      ],
      "prefill": "all",
      "title": "Transmission",
      "type": "string"
    },
    "vehicleType": {
      "description": "Vehicle category used in searchVehicles mode.",
      "editor": "select",
      "enum": [
        "cars-trucks",
        "motorcycles",
        "boats",
        "rvs-campers",
        "atvs-utvs-snowmobiles",
        "commercial-trucks",
        "other-vehicles"
      ],
      "enumTitles": [
        "Cars & Trucks",
        "Motorcycles",
        "Boats",
        "RVs & Campers",
        "ATVs, UTVs & Snowmobiles",
        "Commercial Trucks",
        "Other Vehicles"
      ],
      "prefill": "cars-trucks",
      "title": "Vehicle Type",
      "type": "string"
    }
  },
  "required": [
    "mode"
  ],
  "schemaVersion": 1,
  "title": "eBay Motors Vehicle & Parts Scraper Input",
  "type": "object"
}

    "episodeUrls": {
      "description": "(mode=byEpisodeUrl) Episode page URLs of the form snapchat.com/p/{publisherId}/{episodeId} or story.snapchat.com/p/{publisherId}/{episodeId}.",
      "editor": "stringList",
      "title": "Episode URLs",
      "type": "array"
    },
    "includeEpisodeMedia": {
      "default": false,
      "description": "(mode=byPublisher) Fetch episode-level HLS video tracks and snap media for each returned episode. Adds extra requests per episode.",
      "prefill": false,
      "title": "Include episode media",
      "type": "boolean"
    },
    "includeShowSeasons": {
      "default": true,
      "description": "(mode=byPublisher) Include premiumShowSeasons[] with season IDs, numbers and declared episode counts.",
      "prefill": false,
      "title": "Include season summary",
      "type": "boolean"
    },
    "includeSpotlights": {
      "default": true,
      "description": "(mode=byPublisher) Include publisherSpotlights[] with media URLs, creator info and engagement stats.",
      "prefill": false,
      "title": "Include publisher Spotlights",
      "type": "boolean"
    },
    "includeStories": {
      "default": true,
      "description": "(mode=byPublisher) Walk every season and return every publicly listed episode in episodes[]. The page's latest stories stay in premiumStories[] for compatibility.",
      "prefill": false,
      "title": "Include full episode history",
      "type": "boolean"
    },
    "locale": {
      "default": "en-US",
      "description": "(mode=discover) Language-region tag such as en-US, en-GB or de-DE. Invalid values fall back to en-US.",
      "editor": "textfield",
      "prefill": "en-US",
      "title": "Locale",
      "type": "string"
    },
    "maxEpisodesPerPublisher": {
      "default": 100,
      "description": "(mode=byPublisher) Hard cap on episodes[] per publisher.",
      "maximum": 5000,
      "minimum": 1,
      "prefill": 3,
      "title": "Max episodes per publisher",
      "type": "integer"
    },
    "maxItems": {
      "default": 100,
      "description": "Hard cap on dataset rows across all modes, including error rows.",
      "maximum": 5000,
      "minimum": 1,
      "prefill": 1,
      "title": "Max dataset rows",
      "type": "integer"
    },
    "mode": {
      "default": "byPublisher",
      "description": "What to collect: publisher catalogues, individual episodes, or the current Discover feed.",
      "editor": "select",
      "enum": [
        "byPublisher",
        "byEpisodeUrl",
        "discover"
      ],
      "enumTitles": [
        "Publishers and shows",
        "Episode URLs",
        "Discover feed by country"
      ],
      "prefill": "byPublisher",
      "title": "Mode",
      "type": "string"
    },
    "publisherUrlsOrIds": {
      "description": "(mode=byPublisher) Publisher or show page URLs, story.snapchat.com/p/{id} links, or bare businessProfileId UUIDs.",

    "propertyType": {
      "default": "",
      "description": "Filter by property type.",
      "editor": "select",
      "enum": [
        "",
        "houses",
        "apartments",
        "studio-apartments",
        "bungalows",
        "duplexes",
        "sites"
      ],
      "enumTitles": [
        "All types",
        "Houses",
        "Apartments",
        "Studio Apartments",
        "Bungalows",
        "Duplexes",

      "default": 50,
      "description": "Maximum number of listings to return.",
      "maximum": 1000,
      "minimum": 1,
      "prefill": 50,
      "title": "Max Items",
      "type": "integer"
    },
    "mode": {
      "default": "searchForSale",
      "description": "What to search for.",
      "editor": "select",
      "enum": [
        "searchForSale",
        "searchForRent",
        "searchToShare"
      ],
      "enumTitles": [
        "Search properties for sale",
        "Search properties for rent",
        "Search rooms / house shares"
      ],
      "prefill": "searchForSale",
      "title": "Mode",
      "type": "string"
    },
    "priceMax": {
      "description": "Maximum price in Euros (optional).",
      "maximum": 100000000,
      "minimum": 0,
      "title": "Max Price (EUR)",
      "type": "integer"
